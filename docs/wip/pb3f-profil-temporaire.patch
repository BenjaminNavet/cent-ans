+//! PB3F-TEMP: where the end of turn goes.
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use data_model::{FactionId, GameData};
+use sim_campaign::CampaignState;
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let turns: u32 = args.first().and_then(|a| a.parse().ok()).unwrap_or(20);
+    let seed: u64 = args.get(1).and_then(|a| a.parse().ok()).unwrap_or(1);
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../../data");
+    let data = GameData::load(&root).expect("game data loads").0;
+    let _ = data.navgrid().component(0, 0);
+    let france = FactionId::new("fac_france").expect("id");
+    let mut state = CampaignState::new_1337(&data, france.clone(), seed).expect("state");
+    state.interactive_battles = false;
+    let ms = |d: Duration| d.as_secs_f64() * 1000.0;
+    let mut sum_total = Duration::ZERO;
+    let mut sum_ai = Duration::ZERO;
+    let mut sum_plan = Duration::ZERO;
+    let mut plan_by: BTreeMap<String, Duration> = BTreeMap::new();
+    let mut phases: BTreeMap<String, Duration> = BTreeMap::new();
+    for _ in 0..turns {
+        for order in ai::plan_turn(&state, &data, &france) {
+            let _ = state.submit_order(&data, order);
+        }
+        let plan_time = RefCell::new(Vec::new());
+        let planner = |s: &CampaignState, d: &GameData, f: &FactionId| {
+            let t = Instant::now();
+            let o = ai::plan_turn(s, d, f);
+            plan_time.borrow_mut().push((f.to_string(), t.elapsed()));
+            o
+        };
+        sim_campaign::turn::PROFILE.lock().unwrap().clear();
+        let t = Instant::now();
+        let (_, timings) = state.end_turn_profiled(&data, planner);
+        let total = t.elapsed();
+        sum_total += total;
+        sum_ai += timings.iter().map(|t| t.1).sum::<Duration>();
+        for (f, d) in plan_time.into_inner() {
+            sum_plan += d;
+            *plan_by.entry(f).or_default() += d;
+        }
+        for (n, d) in sim_campaign::turn::PROFILE.lock().unwrap().iter() {
+            *phases.entry(n.clone()).or_default() += *d;
+        }
+    }
+    let n = f64::from(turns);
+    println!(
+        "per turn: total {:.1} ms, AI factions {:.1} ms (planner {:.1} ms), rest {:.1} ms",
+        ms(sum_total) / n,
+        ms(sum_ai) / n,
+        ms(sum_plan) / n,
+        ms(sum_total - sum_ai) / n
+    );
+    let mut v: Vec<_> = plan_by.into_iter().collect();
+    v.sort_by_key(|a| std::cmp::Reverse(a.1));
+    for (f, d) in v.iter().take(10) {
+        println!("  plan {f}: {:.2} ms", ms(*d) / n);
+    }
+    let mut v: Vec<_> = phases.into_iter().collect();
+    v.sort_by_key(|a| std::cmp::Reverse(a.1));
+    for (f, d) in v.iter().take(30) {
+        println!("  phase {f}: {:.2} ms", ms(*d) / n);
+    }
+}
