{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hud_labels.schema.json",
  "title": "Libellés des chiffres du HUD de campagne",
  "description": "Mot affiché devant chacun des chiffres de la barre du haut (hommes, prestige, désordre). Rendu et textes seulement.",
  "type": "object",
  "required": ["figures"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "figures": {
      "type": "object",
      "required": ["manpower", "prestige", "unrest"],
      "additionalProperties": false,
      "properties": {
        "manpower": {"type": "string", "minLength": 1, "maxLength": 20},
        "prestige": {"type": "string", "minLength": 1, "maxLength": 20},
        "unrest": {"type": "string", "minLength": 1, "maxLength": 20}
      }
    }
  }
}
