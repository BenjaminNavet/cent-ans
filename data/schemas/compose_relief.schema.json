{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/compose_relief.schema.json",
  "title": "Réglages du relief composé",
  "description": "data/map/compose/relief.json (lot CC C2) : hauteur procédurale de la carte composée, bâtie sur compose/ridges.json. Pixels du canevas composé, mètres.",
  "type": "object",
  "required": [
    "version",
    "seed",
    "sea",
    "plain",
    "zones",
    "massif",
    "hills",
    "passes",
    "rivers",
    "platforms",
    "fine",
    "socle"
  ],
  "additionalProperties": false,
  "$defs": {
    "ridge_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "halfwidth_scale",
        "crest_exponent",
        "foot_amp",
        "foot_halfwidths",
        "crest_wavelength_px",
        "crest_variation",
        "spur_wavelength_along_px",
        "spur_wavelength_across_px",
        "spur_amp"
      ],
      "properties": {
        "height_gain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_min_m": {
          "type": "number"
        },
        "height_max_m": {
          "type": "number"
        },
        "halfwidth_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crest_exponent": {
          "type": "number",
          "minimum": 0.5
        },
        "foot_amp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "foot_halfwidths": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "crest_wavelength_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crest_variation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spur_wavelength_along_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spur_wavelength_across_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spur_amp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rock_amp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rock_wavelength_px": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "sea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shelf_px",
        "shelf_depth_m",
        "deep_depth_m",
        "deep_px",
        "outside_m"
      ],
      "properties": {
        "shelf_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shelf_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deep_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "deep_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outside_m": {
          "type": "number",
          "maximum": -1
        }
      }
    },
    "plain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coast_ramp_px",
        "coast_ramp_m",
        "micro_amp_m",
        "micro_wavelength_px"
      ],
      "properties": {
        "coast_ramp_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coast_ramp_m": {
          "type": "number",
          "minimum": 0
        },
        "micro_amp_m": {
          "type": "number",
          "minimum": 0
        },
        "micro_wavelength_px": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sigma_px",
        "floor_m",
        "knee_m",
        "gain",
        "max_m",
        "noise_amp",
        "noise_wavelength_px"
      ],
      "properties": {
        "sigma_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "floor_m": {
          "type": "number",
          "minimum": 0
        },
        "knee_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gain": {
          "type": "number",
          "minimum": 0
        },
        "max_m": {
          "type": "number",
          "minimum": 0
        },
        "noise_amp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "noise_wavelength_px": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "massif": {
      "$ref": "#/$defs/ridge_profile"
    },
    "hills": {
      "$ref": "#/$defs/ridge_profile"
    },
    "passes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attach_free_px",
        "floor_max_m",
        "floor_min_m",
        "axis_slope_m_per_px",
        "wall_slope_m_per_px",
        "reach_halfwidths",
        "min_half_width_px",
        "wall_widening",
        "meander_px",
        "meander_wavelength_px",
        "round_px"
      ],
      "properties": {
        "attach_free_px": {
          "type": "number",
          "minimum": 0
        },
        "floor_max_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "floor_min_m": {
          "type": "number",
          "minimum": 0
        },
        "axis_slope_m_per_px": {
          "type": "number",
          "minimum": 0
        },
        "wall_slope_m_per_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reach_halfwidths": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_half_width_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wall_widening": {
          "type": "number",
          "minimum": 0
        },
        "meander_px": {
          "type": "number",
          "minimum": 0
        },
        "meander_wavelength_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "round_px": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rivers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valley_base_px",
        "valley_per_width_px",
        "major_valley_px",
        "major_width_px",
        "channel_px",
        "bed_margin_m",
        "bed_floor_m",
        "bed_slope_m_per_px",
        "smooth_samples",
        "max_cut_m",
        "valley_depth_max_m"
      ],
      "properties": {
        "valley_base_px": {
          "type": "number",
          "minimum": 0
        },
        "valley_per_width_px": {
          "type": "number",
          "minimum": 0
        },
        "major_valley_px": {
          "type": "number",
          "minimum": 0
        },
        "major_width_px": {
          "type": "number",
          "minimum": 0
        },
        "channel_px": {
          "type": "number",
          "minimum": 0
        },
        "bed_margin_m": {
          "type": "number",
          "minimum": 0
        },
        "bed_floor_m": {
          "type": "number",
          "minimum": 0
        },
        "bed_slope_m_per_px": {
          "type": "number",
          "minimum": 0
        },
        "smooth_samples": {
          "type": "integer",
          "minimum": 1
        },
        "max_cut_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valley_depth_max_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius_px",
        "blend_px",
        "max_shift_m"
      ],
      "properties": {
        "radius_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blend_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_shift_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail_amp_m",
        "detail_floor_m",
        "detail_ref_m",
        "wavelength_fine_px"
      ],
      "properties": {
        "detail_amp_m": {
          "type": "number",
          "minimum": 0
        },
        "detail_floor_m": {
          "type": "number",
          "minimum": 0
        },
        "detail_ref_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wavelength_fine_px": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        }
      }
    },
    "socle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "halfwidths",
        "closing_px",
        "blur_px",
        "height_fraction",
        "peak_wavelengths_px",
        "peak_weights",
        "peak_mean",
        "peak_amp",
        "peak_lift"
      ],
      "properties": {
        "halfwidths": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closing_px": {
          "type": "number",
          "minimum": 0
        },
        "blur_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "peak_wavelengths_px": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        },
        "peak_weights": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1
        },
        "peak_mean": {
          "type": "number"
        },
        "peak_amp": {
          "type": "number",
          "minimum": 0
        },
        "peak_lift": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}