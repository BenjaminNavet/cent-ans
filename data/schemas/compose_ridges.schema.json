{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/compose_ridges.schema.json",
  "title": "Crêtes d'auteur de la carte composée",
  "description": "data/map/compose/ridges.json (lot CC C1, entrée de C2) : polylignes en pixels du canevas composé, largeur, hauteur et cols. Généré par `cent-ans geo compose`, retouchable à la main.",
  "type": "object",
  "required": [
    "version",
    "size_px",
    "ridges"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "size_px": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "ridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "points",
          "width_px",
          "height_m",
          "passes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "massif",
              "hills"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "width_px": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_m": {
            "type": "number"
          },
          "passes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "at",
                "width_px"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "at": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "width_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "depth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "authored": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "deleted_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Crêtes générées (squelette C1) supprimées par l'auteur : ne reviennent pas à la recompilation."
    },
    "chains_seeded": {
      "type": "boolean",
      "description": "Vrai une fois les chaînes d'auteur de ridges_author.CHAINS recopiées dans ce fichier ; ensuite les crêtes `authored` font foi."
    }
  }
}
