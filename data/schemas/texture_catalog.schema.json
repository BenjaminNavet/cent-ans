{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "texture_catalog.schema.json",
  "title": "Catalogue d'une famille de textures générées (TX, ADR 0236)",
  "description": "Lu par `tools/cent_ans_tools/texture_factory/catalog.py`. Une entrée = une matière : prompt, taille réelle de la tuile, biomes ou régions, graine, plages de contrôle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "size", "output_size", "style_prefix", "style_suffix", "entries"],
  "properties": {
    "family": {"enum": ["ground_campaign", "ground_battle", "vegetation_cards", "foliage_bark", "building_materials", "water_surfaces", "micro_detail"]},
    "backend": {"enum": ["fal", "local"], "description": "fal (défaut) : Z-Image Turbo sur fal.ai ; local : mflux (ADR 0190)."},
    "size": {"enum": [1024, 1536, 2048]},
    "output_size": {"const": 2048},
    "upscale": {"enum": ["esrgan", "esrgan_light", "lanczos", "native"]},
    "style_prefix": {"type": "string"},
    "style_suffix": {"type": "string"},
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Passe seamless/PBR (process.py) : largeur de raccord (px à 1024), luminance cible, force de la hauteur, rugosité.",
      "properties": {
        "blend_width": {"type": "integer", "minimum": 8},
        "feather": {"type": "number", "minimum": 0},
        "target_luminance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height_strength": {"type": "number", "minimum": 0},
        "roughness": {"type": "number", "minimum": 0, "maximum": 1},
        "equalize": {"type": "boolean", "description": "Faux : garde la luminance propre de chaque image (bâtiments : chaux blanche ou ardoise sombre)."}
      }
    },
    "packs": {
      "type": "array",
      "description": "Tableaux de textures produits par `cent-ans textures pack` : rôles retenus, fichiers sous game/<texture_dir>, manifeste, tailles ; hi_dir reçoit la variante 2k (hors budget du dépôt).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "roles", "texture_dir", "manifest", "layer_size"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "kind": {"enum": ["tile", "cards", "sheet", "files", "tiles"], "description": "tile (défaut) : raccord + normale ; cards : cartes détourées recadrées en tableau RGBA (WebP) ; sheet : planches détourées entières en tableau RGBA ; files : une carte WebP par entrée ; tiles : albédo et normale JPEG 2k par entrée (eau)."},
          "texture_dir": {"type": "string"},
          "hi_dir": {"type": "string"},
          "albedo": {"type": "string"},
          "normal": {"type": "string"},
          "manifest": {"type": "string"},
          "layer_size": {"enum": [512, 1024, 2048]},
          "normal_size": {"enum": [256, 512, 1024]},
          "strip_prefix": {"type": "string"},
          "max_mb": {"type": "number", "exclusiveMinimum": 0},
          "albedo_quality": {"type": "integer", "minimum": 50, "maximum": 98},
          "normal_quality": {"type": "integer", "minimum": 50, "maximum": 98}
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "prompt", "seed", "tile_m"],
        "oneOf": [{"required": ["biomes"]}, {"required": ["regions"]}],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "role": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 0},
          "tile_m": {"type": "number", "exclusiveMinimum": 0},
          "biomes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1, "maximum": 14}
          },
          "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "size": {"enum": [1024, 1536, 2048]},
          "alpha": {"type": "boolean"},
          "species": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Facultatif : id d'une essence de data/art/tree_species.yaml (famille foliage_bark)."},
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "luminance": {"$ref": "#/$defs/range"},
              "saturation": {"$ref": "#/$defs/range"},
              "seam_max": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    }
  }
}
