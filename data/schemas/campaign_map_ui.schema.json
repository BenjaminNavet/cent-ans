{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign_map_ui.schema.json",
  "title": "Rendu de la carte de campagne (CV3-5)",
  "description": "Réglages purement visuels de la carte de campagne, lus par game/scripts/map/army_figures.gd (map) et game/scripts/map/map_readability.gd (blocs TB2). Aucune règle de jeu.",
  "type": "object",
  "required": [
    "map"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "army_figure_scale"
      ],
      "additionalProperties": false,
      "properties": {
        "army_figure_scale": {
          "description": "Échelle du général à cheval (porteur de l'étendard de l'ost) par rapport aux autres figurines de l'armée ; 1 = même taille que l'escorte.",
          "type": "number",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "fog_of_war": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desaturation",
        "dim",
        "veil_color",
        "veil_strength",
        "mist_color",
        "mist_max",
        "mist_min",
        "mist_glow"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "desaturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Part de camaïeu sépia du sol hors de vue."
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Facteur de luminosité du sol hors de vue (1 = inchangé)."
        },
        "veil_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Ton parchemin du voile."
        },
        "veil_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Lavis uni par-dessus le sol (0 = aucun)."
        },
        "mist_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mist_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "Opacité du reste de brume ; bornée pour ne plus effacer le relief."
        },
        "mist_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "mist_glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "signs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_per_town",
        "incident",
        "encounter",
        "construction"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "max_per_town": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Nombre de signes par ville et par palier en mode politique (vérifié par game/tests/tb2_declutter_test.gd)."
        },
        "incident": {
          "$ref": "#/$defs/sign_rule"
        },
        "encounter": {
          "$ref": "#/$defs/sign_rule"
        },
        "construction": {
          "$ref": "#/$defs/sign_rule"
        }
      }
    }
  },
  "$defs": {
    "sign_rule": {
      "type": "object",
      "required": [
        "modes"
      ],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Modes de carte (MapModeController.MODES) qui affichent ce signe."
        },
        "keep_urgent": {
          "type": "boolean",
          "description": "Reste visible quand il expire ou attend une réponse ce tour."
        },
        "with_selected_army": {
          "type": "boolean",
          "description": "Visible quand une armée est sélectionnée."
        }
      }
    }
  }
}
