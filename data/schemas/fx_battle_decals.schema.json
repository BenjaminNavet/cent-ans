{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/fx_battle_decals.schema.json",
  "title": "Décals de traces au sol de la bataille",
  "description": "Fichier data/fx/battle_decals.json (lot decals) : décals clusterisés Bevy (sang, boue de charge). Rendu seulement, désactivé par défaut.",
  "type": "object",
  "$defs": {
    "range": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 }
  },
  "properties": {
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "max_decals": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "lifetime_s": { "type": "number", "exclusiveMinimum": 0 },
    "fade_s": { "type": "number", "minimum": 0 },
    "projection_depth_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
    "max_per_frame": { "type": "integer", "minimum": 1, "maximum": 64 },
    "blood": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size_m": { "$ref": "#/$defs/range" },
        "min_interval_s": { "type": "number", "minimum": 0 }
      },
      "required": ["enabled", "size_m", "min_interval_s"],
      "additionalProperties": false
    },
    "mud": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size_m": { "$ref": "#/$defs/range" },
        "interval_s": { "type": "number", "exclusiveMinimum": 0 },
        "contact_scale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["enabled", "size_m", "interval_s", "contact_scale"],
      "additionalProperties": false
    }
  },
  "required": ["enabled", "max_decals", "lifetime_s", "fade_s", "projection_depth_m", "max_per_frame", "blood", "mud"],
  "additionalProperties": false
}
