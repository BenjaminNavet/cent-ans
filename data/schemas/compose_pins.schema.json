{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/compose_pins.schema.json",
  "title": "Épingles d'auteur de la déformation",
  "description": "data/map/compose/pins.json (lot CC C1) : corrections locales du cartogramme. Le point réel `lonlat` est ramené à `target_px` (pixels du canevas composé), influence gaussienne de rayon `radius_km`.",
  "type": "object",
  "required": [
    "version",
    "pins"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lonlat",
          "target_px"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "lonlat": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "target_px": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius_km": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 150
          }
        }
      }
    }
  }
}
