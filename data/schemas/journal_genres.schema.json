{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journal_genres.schema.json",
  "title": "Genres du filtre du journal (WR turn)",
  "description": "Regroupement des genres d'événements (`kind`) en genres de filtre du journal de campagne. Rendu seulement.",
  "type": "object",
  "required": ["all_label", "other", "genres"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "all_label": {"type": "string", "minLength": 1},
    "other": {"type": "string", "minLength": 1, "description": "Identifiant du genre des événements non listés."},
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kinds"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/snake_id"},
          "label": {"type": "string", "minLength": 1},
          "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/snake_id"}}
        }
      }
    }
  }
}
