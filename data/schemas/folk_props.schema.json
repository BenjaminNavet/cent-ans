{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "folk_props.schema.json",
  "title": "Table des modèles de la carte vivante",
  "type": "object",
  "required": [
    "props",
    "roles",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "props": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speed",
          "length_m"
        ],
        "properties": {
          "fk2": {
            "type": "string"
          },
          "dn": {
            "type": "string"
          },
          "yaw_deg": {
            "type": "number"
          },
          "speed": {
            "type": "number",
            "minimum": 0
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "team": {
            "type": "object",
            "required": [
              "role",
              "count",
              "gap_m"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "gap_m": {
                "type": "number"
              }
            }
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "type": "integer",
                  "enum": [
                    -1,
                    0,
                    1
                  ]
                },
                "margin": {
                  "type": "number"
                },
                "abs": {
                  "type": "boolean"
                },
                "at": {
                  "type": "number"
                },
                "offset": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "figures",
          "livery"
        ],
        "additionalProperties": false,
        "properties": {
          "figures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "livery": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "activities": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "drab": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}