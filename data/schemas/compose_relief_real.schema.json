{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/compose_relief_real.schema.json",
  "title": "Réglages du relief réel déformé",
  "description": "data/map/compose/relief_real.json (lot CC CD).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "real_root_candidates",
    "crest",
    "lowland_cap_m",
    "refine",
    "passes",
    "delta_smooth_px"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "real_root_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band_px",
        "fade_px",
        "peak_radius_px",
        "floor_real_frac",
        "floor_author_frac",
        "floor_author_cap_m"
      ],
      "properties": {
        "band_px": {
          "type": "number"
        },
        "fade_px": {
          "type": "number"
        },
        "peak_radius_px": {
          "type": "number"
        },
        "floor_real_frac": {
          "type": "number"
        },
        "floor_author_frac": {
          "type": "number"
        },
        "floor_author_cap_m": {
          "type": "number"
        }
      }
    },
    "lowland_cap_m": {
      "type": "number"
    },
    "refine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "min_relief_m",
        "min_real_coverage"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          }
        },
        "min_relief_m": {
          "type": "number"
        },
        "min_real_coverage": {
          "type": "number"
        }
      }
    },
    "passes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth_frac",
        "along_halfwidths",
        "across_halfwidths"
      ],
      "properties": {
        "depth_frac": {
          "type": "number"
        },
        "along_halfwidths": {
          "type": "number"
        },
        "across_halfwidths": {
          "type": "number"
        }
      }
    },
    "delta_smooth_px": {
      "type": "number"
    }
  }
}
