{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_battle_ground_layers.schema.json",
  "title": "Couches du sol de bataille (lots GA2 puis TX T2c, ADR 0240)",
  "description": "Sol de bataille régional : `roles` donne l'ordre fixe des couches du `Texture2DArray` (contrat de `battle_ground.gdshader`, index = position), `materials` associe à chaque rôle la matière générée de chaque biome (1..14, écrit par `cent-ans textures battle-data` depuis les paquets `battle_bNN` de `data/art/textures/ground_battle.yaml`), `pack_manifest` le manifeste du paquet d'un biome (`{biome}` sur deux chiffres ; tailles de répétition = `tile_m` des couches du manifeste). Repli : biome, parent (`data/map/biome_parents.json`), puis `default_biome` (ADR 0244 : plus de jeu Poly Haven). `micro` : grain fin fondu sous ~30 m de caméra, par rôle. `terrain_biomes` : biome d'une bataille sans province, selon le terrain de simulation.",
  "type": "object",
  "required": ["roles", "default_biome", "terrain_biomes", "pack_manifest", "materials", "micro"],
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "grass", "meadow", "forest", "dirt", "mud", "pebbles", "rock",
        "plough", "snow", "flowering_meadow", "trodden_grass", "stubble",
        "fresh_plough"
      ]
    },
    "biome": {"type": "integer", "minimum": 1, "maximum": 14}
  },
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/role"}
    },
    "default_biome": {"$ref": "#/$defs/biome"},
    "terrain_biomes": {
      "type": "object",
      "propertyNames": {"enum": ["plains", "hills", "mountains", "forest", "marsh", "heath", "bocage", "steppe", "desert"]},
      "additionalProperties": {"$ref": "#/$defs/biome"}
    },
    "pack_manifest": {"type": "string", "pattern": "\\{biome\\}"},
    "materials": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/role"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "^([1-9]|1[0-4])$"},
        "additionalProperties": {"$ref": "common.schema.json#/$defs/snake_id"}
      }
    },
    "micro": {
      "type": "object",
      "required": ["manifest", "default", "role_grain", "dry_biomes", "dry_role_grain"],
      "additionalProperties": false,
      "properties": {
        "manifest": {"type": "string"},
        "default": {"$ref": "common.schema.json#/$defs/snake_id"},
        "role_grain": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/role"},
          "additionalProperties": {"$ref": "common.schema.json#/$defs/snake_id"}
        },
        "dry_biomes": {"type": "array", "items": {"$ref": "#/$defs/biome"}},
        "dry_role_grain": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/role"},
          "additionalProperties": {"$ref": "common.schema.json#/$defs/snake_id"}
        }
      }
    }
  }
}
