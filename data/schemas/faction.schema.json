{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/faction.schema.json",
  "title": "Faction",
  "description": "État ou puissance de la carte de campagne (royaume, duché, comté, république, papauté...).",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/faction_id" },
    "name": { "$ref": "common.schema.json#/$defs/localized_name" },
    "short_name": { "type": "string", "description": "Nom court pour l'UI (ex. 'France')." },
    "adjective": { "type": "string", "description": "Adjectif français (ex. 'français', 'anglais')." },
    "government": {
      "type": "string",
      "enum": ["kingdom", "duchy", "county", "principality", "republic", "theocracy", "empire", "lordship"]
    },
    "playable": { "type": "boolean", "default": false },
    "ruler": { "$ref": "common.schema.json#/$defs/character_id" },
    "heir": { "$ref": "common.schema.json#/$defs/character_id", "description": "Héritier présomptif en 1337 selon la loi de succession." },
    "capital": { "$ref": "common.schema.json#/$defs/province_id" },
    "capital_city": { "type": "string", "description": "Nom de la ville capitale (français)." },
    "religion": { "$ref": "common.schema.json#/$defs/religion_id" },
    "culture": { "$ref": "common.schema.json#/$defs/culture_id" },
    "succession_law": {
      "type": "string",
      "description": "Règle de succession : salique (agnatique stricte), primogéniture masculine préférentielle, cognatique, élective (empire, république, papauté).",
      "enum": ["salic", "male_preference_primogeniture", "cognatic_primogeniture", "elective"]
    },
    "suzerain": {
      "$ref": "common.schema.json#/$defs/faction_id",
      "description": "Faction dont celle-ci est vassale (hommage lige) au départ."
    },
    "primary_title": {
      "$ref": "common.schema.json#/$defs/title_id",
      "description": "Titre principal (lot FE, ADR 0098) : son rang et son suzerain de jure placent la faction dans l'arbre féodal."
    },
    "heraldry": {
      "type": "object",
      "properties": {
        "blazon": { "type": "string", "description": "Blasonnement en français héraldique." },
        "description": { "type": "string", "description": "Description en français courant." },
        "primary_color": { "$ref": "common.schema.json#/$defs/color_hex" },
        "secondary_color": { "$ref": "common.schema.json#/$defs/color_hex" },
        "uncertain": { "type": "boolean", "default": false },
        "note": { "type": "string" }
      },
      "required": ["blazon", "primary_color"],
      "additionalProperties": false
    },
    "titles": {
      "type": "array",
      "description": "Titres portés par le souverain de la faction en 1337.",
      "items": { "type": "string" }
    },
    "treasury": { "type": "integer", "minimum": 0, "description": "Trésor de départ en livres tournois." },
    "prestige": { "type": "integer", "minimum": 0 },
    "starting_technologies": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/technology_id" },
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "description": "Relations diplomatiques de départ avec d'autres factions.",
      "items": {
        "type": "object",
        "properties": {
          "faction": { "$ref": "common.schema.json#/$defs/faction_id" },
          "status": { "type": "string", "enum": ["war", "peace", "alliance", "truce", "embargo", "vassal", "overlord", "marriage_tie"] },
          "since": { "$ref": "common.schema.json#/$defs/historical_date" },
          "until": { "$ref": "common.schema.json#/$defs/historical_date" },
          "note": { "type": "string" }
        },
        "required": ["faction", "status"],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "description": "Prétentions de départ (casus belli) : trône d'une autre faction ou province.",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["throne", "province"] },
          "faction": { "$ref": "common.schema.json#/$defs/faction_id" },
          "province": { "$ref": "common.schema.json#/$defs/province_id" },
          "note": { "type": "string" }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    },
    "victory": {
      "type": "object",
      "description": "Conditions de victoire d'une faction jouable : tous les objectifs remplis avant end_year.",
      "properties": {
        "end_year": { "type": "integer" },
        "hold_turns": { "type": "integer", "minimum": 1, "description": "Saisons consécutives pendant lesquelles tous les objectifs doivent être tenus avant la victoire (défaut : 1)." },
        "summary": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^obj_[a-z0-9_]+$" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "condition": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["control_all", "control_count", "no_foreign_control", "independent", "subjugate"] },
                  "provinces": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/province_id" } },
                  "faction": { "$ref": "common.schema.json#/$defs/faction_id" },
                  "count": { "type": "integer", "minimum": 1 }
                },
                "required": ["kind"],
                "additionalProperties": false
              }
            },
            "required": ["id", "title", "description", "condition"],
            "additionalProperties": false
          }
        }
      },
      "required": ["end_year", "objectives"],
      "additionalProperties": false
    },
    "ai_personality": {
      "type": "object",
      "properties": {
        "aggression": { "$ref": "common.schema.json#/$defs/percent" },
        "diplomacy": { "$ref": "common.schema.json#/$defs/percent" },
        "trade": { "$ref": "common.schema.json#/$defs/percent" },
        "piety": { "$ref": "common.schema.json#/$defs/percent" }
      },
      "additionalProperties": false
    },
    "description": { "type": "string" },
    "sources": { "$ref": "common.schema.json#/$defs/sources" }
  },
  "required": ["id", "name", "government", "capital", "religion", "culture", "succession_law", "heraldry"],
  "additionalProperties": false
}
