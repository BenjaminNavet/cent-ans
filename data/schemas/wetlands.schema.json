{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/wetlands.schema.json",
  "title": "Zones humides et pays d'étangs vers 1340",
  "description": "Fichier data/map/wetlands.json (lot R1) : marais, pays d'étangs et prés humides historiques de la carte de campagne, en ellipses ou polygones approximatifs (lon/lat WGS84). Lu par tools/cent_ans_tools/geo/landcover.py qui en fait data/map/wetlands.png (R marais, G étangs, B prés humides) ; rendu seulement.",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/area" }
    }
  },
  "required": ["areas"],
  "additionalProperties": false,
  "$defs": {
    "lonlat": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -11, "maximum": 16 },
        { "type": "number", "minimum": 35, "maximum": 60 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ellipse": {
      "type": "object",
      "properties": {
        "center": { "$ref": "#/$defs/lonlat" },
        "radii_km": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "angle_deg": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["center", "radii_km"],
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["marsh", "ponds", "wet_meadow"],
          "description": "Marais (roselières, eau stagnante, chenaux), pays d'étangs (étangs médiévaux de pisciculture), prés humides et tourbières."
        },
        "density": { "type": "number", "minimum": 0, "maximum": 1, "description": "Intensité (part du sol concernée)." },
        "ellipse": { "$ref": "#/$defs/ellipse" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/lonlat" }
        },
        "max_height_m": { "type": "number", "description": "Altitude au-delà de laquelle la zone s'efface (marais de fond de vallée)." },
        "source": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["id", "name", "kind", "density", "source"],
      "oneOf": [
        { "required": ["ellipse"] },
        { "required": ["polygon"] }
      ],
      "additionalProperties": false
    }
  }
}
