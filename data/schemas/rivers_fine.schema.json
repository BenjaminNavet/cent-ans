{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/rivers_fine.schema.json",
  "title": "Manifeste du réseau hydrographique fin",
  "description": "Fichier data/map/rivers_fine.json (lot ZG5a, ADR 0036), écrit par `cent-ans geo hydro-fine` : index des tuiles binaires CAFV (hors git, sous data/map/pyramid/hydro_fine/) des cours d'eau recalés sur la pyramide de relief. Rendu seulement.",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "version": { "const": 1 },
    "format": { "const": "CAFV" },
    "format_version": { "const": 1 },
    "layer": { "const": 1 },
    "tile_level": { "type": "integer", "minimum": 0, "maximum": 7 },
    "tile_units": { "type": "number", "exclusiveMinimum": 0 },
    "dir": { "type": "string" },
    "pattern": { "type": "string", "pattern": "\\{col\\}_\\{row\\}\\.bin$" },
    "features_file": { "type": "string" },
    "coordinates": { "type": "string" },
    "z": { "type": "string" },
    "width": { "type": "string" },
    "flags": {
      "type": "object",
      "properties": {
        "divagating": { "type": "integer" },
        "tidal": { "type": "integer" },
        "intermittent": { "type": "integer" },
        "rectified": { "type": "integer" },
        "coarse": { "type": "integer" },
        "wetland": { "type": "integer" },
        "order_shift": { "const": 24 },
        "source_shift": { "const": 28 }
      },
      "required": ["divagating", "tidal", "intermittent", "rectified", "coarse", "wetland", "order_shift", "source_shift"],
      "additionalProperties": false
    },
    "sources": { "type": "object", "additionalProperties": { "type": "string" } },
    "source_codes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 15 } },
    "stats": {
      "type": "object",
      "properties": {
        "lines": { "type": "integer", "minimum": 0 },
        "km_by_source": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "tiles": { "type": "integer", "minimum": 0 },
        "points": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["lines", "km_by_source", "tiles", "points", "total_bytes"],
      "additionalProperties": false
    },
    "generated_at": { "type": "string" },
    "tiles": { "type": "array", "items": { "$ref": "#/$defs/tile" } }
  },
  "required": ["version", "format", "layer", "tile_level", "dir", "pattern", "features_file", "flags", "sources", "stats", "tiles"],
  "additionalProperties": false,
  "$defs": {
    "tile": {
      "type": "object",
      "properties": {
        "col": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "points": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 32 },
        "sha1": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
      },
      "required": ["col", "row", "lines", "points", "bytes", "sha1"],
      "additionalProperties": false
    }
  }
}
