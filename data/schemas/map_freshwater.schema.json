{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map_freshwater.schema.json",
  "title": "Eaux douces et zones humides de la carte (lot DN-ME4)",
  "type": "object",
  "required": ["render", "reeds", "models", "torrent", "salt_pans", "waterfalls", "fords", "glacier"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "render": {
      "type": "object",
      "additionalProperties": {"type": "number"},
      "required": ["fade_start", "fade_end", "patch_max_distance", "near_max_distance", "patch_block_units", "patch_spacing_units", "near_block_units", "near_spacing_units", "max_blocks_per_frame", "max_cached_blocks", "max_instances", "scale_near_distance", "scale_far_distance", "far_scale", "seed"]
    },
    "reeds": {
      "type": "object",
      "required": ["card_texture", "card_cards", "clump_width_m", "clump_height_m", "kinds", "lagoon_ids", "pool_diameter_m"],
      "additionalProperties": false,
      "properties": {
        "card_texture": {"type": "string"},
        "card_cards": {"type": "array", "items": {"type": "string"}},
        "clump_width_m": {"type": "number", "exclusiveMinimum": 0},
        "clump_height_m": {"type": "number", "exclusiveMinimum": 0},
        "pool_diameter_m": {"type": "number", "exclusiveMinimum": 0},
        "lagoon_ids": {"type": "array", "items": {"type": "string"}},
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["cover", "pool_share", "tint"],
            "additionalProperties": false,
            "properties": {
              "cover": {"type": "number", "minimum": 0, "maximum": 1},
              "pool_share": {"type": "number", "minimum": 0, "maximum": 1},
              "tint": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
            }
          }
        }
      }
    },
    "models": {"type": "object", "additionalProperties": {"type": "string"}},
    "torrent": {"type": "object", "additionalProperties": {"type": "number"}},
    "salt_pans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "center", "size_km", "angle_deg", "tint"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "center": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "size_km": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "angle_deg": {"type": "number"},
          "tint": {"enum": ["rose", "grey"]}
        }
      }
    },
    "waterfalls": {"type": "array", "items": {"$ref": "#/$defs/site"}},
    "fords": {"type": "array", "items": {"$ref": "#/$defs/site"}},
    "glacier": {
      "type": "object",
      "required": ["line_m", "full_m", "max_slope", "ice_color", "crevasse_color"],
      "additionalProperties": false,
      "properties": {
        "line_m": {"type": "number"},
        "full_m": {"type": "number"},
        "max_slope": {"type": "number"},
        "ice_color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "crevasse_color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": ["id", "name", "lonlat"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "lonlat": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "height_m": {"type": "number"},
        "width_m": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
