{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/naval_fleets.schema.json",
  "title": "Flottes de 1337",
  "description": "Fichier data/naval/fleets.json (lot NV1, ADR 0028) : navires de guerre de chaque faction au début de la campagne et mers où elle les arme (elle peut y intercepter les traversées ennemies).",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "fleets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "faction": { "type": "string", "pattern": "^fac_[a-z0-9_]+$" },
          "ships": {
            "type": "object",
            "propertyNames": { "pattern": "^ship_[a-z0-9_]+$" },
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "seas": {
            "type": "array",
            "items": { "type": "string", "pattern": "^sea_[a-z0-9_]+$" },
            "minItems": 1
          },
          "note": { "type": "string" }
        },
        "required": ["faction", "ships", "seas"],
        "additionalProperties": false
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["fleets"],
  "additionalProperties": false
}
