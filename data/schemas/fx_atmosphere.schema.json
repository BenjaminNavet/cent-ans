{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/fx_atmosphere.schema.json",
  "title": "Ciels et étalonnage",
  "description": "Fichier data/fx/atmosphere.json (lot V3, A1-05) : ciels HDRI et étalonnage par météo et par saison, lus par game/scripts/visual/atmosphere_library.gd. Aucune règle de jeu.",
  "type": "object",
  "$defs": {
    "motion_part": {
      "type": "object",
      "description": "AN1a : amplitudes d'une pièce souple (déplacement au bord libre, m).",
      "properties": {
        "speed_amp_m": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Recul dû à la marche, à la vitesse de référence." },
        "wind_amp_m": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Poussée du vent à force 1." },
        "flutter_amp_m": { "type": "number", "minimum": 0, "maximum": 0.2, "description": "Ondulation (flottement) à force et vitesse pleines." },
        "flutter_hz": { "type": "number", "minimum": 0, "maximum": 6, "description": "Fréquence de l'ondulation." },
        "lift": { "type": "number", "minimum": 0, "maximum": 1, "description": "Part du déplacement qui soulève le bord (évasement)." },
        "hem_y_m": { "type": "number", "minimum": 0, "maximum": 3, "description": "Caparaçon : hauteur de l'ourlet en pose de repos (poids 1)." },
        "top_y_m": { "type": "number", "minimum": 0, "maximum": 3, "description": "Caparaçon : hauteur où le poids s'annule (selle, garrot)." }
      },
      "required": ["speed_amp_m", "wind_amp_m", "flutter_amp_m", "flutter_hz"],
      "additionalProperties": false
    },
    "rgb": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 2 }, "minItems": 3, "maxItems": 3 },
    "offset": { "type": "array", "items": { "type": "number", "minimum": -0.5, "maximum": 0.5 }, "minItems": 3, "maxItems": 3 },
    "season_map": {
      "type": "object",
      "properties": {
        "spring": { "type": "string" }, "summer": { "type": "string" },
        "autumn": { "type": "string" }, "winter": { "type": "string" }
      },
      "required": ["spring", "summer", "autumn", "winter"],
      "additionalProperties": false
    },
    "grade": {
      "type": "object",
      "description": "Étalonnage (espace sRGB) : balance des blancs, lift/gamma/gain, contraste, saturation, virage.",
      "properties": {
        "temperature": { "type": "number", "minimum": -1, "maximum": 1, "description": "Froid (-) / chaud (+)." },
        "tint": { "type": "number", "minimum": -1, "maximum": 1, "description": "Vert (-) / magenta (+)." },
        "lift": { "$ref": "#/$defs/offset" },
        "gamma": { "$ref": "#/$defs/rgb" },
        "gain": { "$ref": "#/$defs/rgb" },
        "contrast": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 2 },
        "shadow_saturation": { "type": "number", "minimum": 0, "maximum": 1, "description": "DA7b : saturation gardée par les tons sombres (pleine effet au noir, nul au-delà de la luminance 0,5)." },
        "shadows": { "$ref": "#/$defs/rgb", "description": "Multiplicateur des tons sombres." },
        "highlights": { "$ref": "#/$defs/rgb", "description": "Multiplicateur des tons clairs." }
      },
      "additionalProperties": false
    },
    "sky_look": {
      "type": "object",
      "properties": {
        "sky_luminance": { "type": "number", "exclusiveMinimum": 0, "maximum": 4, "description": "Luminance moyenne visée du ciel (le panorama est normalisé par sa moyenne)." },
        "sky_saturation": { "type": "number", "minimum": 0, "maximum": 2 },
        "sky_tint": { "$ref": "#/$defs/rgb" },
        "sun_disc": { "type": "number", "minimum": 0, "maximum": 2 },
        "haze": { "type": "number", "minimum": 0, "maximum": 1, "description": "Voile d'horizon vers la couleur du brouillard." }
      }
    }
  },
  "properties": {
    "description": { "type": "string" },
    "lut_size": { "type": "integer", "minimum": 8, "maximum": 64 },
    "skies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "pattern": "^res://.+\\.(hdr|exr)$" },
          "sun_azimuth_deg": { "type": "number", "minimum": 0, "maximum": 360 },
          "sun_elevation_deg": { "type": "number", "minimum": -10, "maximum": 90 },
          "mean": { "type": "number", "exclusiveMinimum": 0 },
          "sunny": { "type": "boolean" }
        },
        "required": ["path", "sun_azimuth_deg", "sun_elevation_deg", "mean", "sunny"],
        "additionalProperties": false
      }
    },
    "seasons": {
      "type": "object",
      "properties": {
        "spring": { "$ref": "#/$defs/grade" }, "summer": { "$ref": "#/$defs/grade" },
        "autumn": { "$ref": "#/$defs/grade" }, "winter": { "$ref": "#/$defs/grade" }
      },
      "required": ["spring", "summer", "autumn", "winter"],
      "additionalProperties": false
    },
    "battle": {
      "type": "object",
      "propertyNames": { "enum": ["clear", "fog", "rain", "snow"] },
      "additionalProperties": {
        "allOf": [{ "$ref": "#/$defs/sky_look" }],
        "type": "object",
        "properties": {
          "sky": { "$ref": "#/$defs/season_map" },
          "grade": { "$ref": "#/$defs/grade" }
        },
        "required": ["sky", "sky_luminance", "grade"]
      }
    },
    "battle_seasons": {
      "type": "object",
      "description": "DA7b : réglages de saison propres aux batailles.",
      "propertyNames": { "enum": ["spring", "summer", "autumn", "winter"] },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "grade": { "$ref": "#/$defs/grade", "description": "Étalonnage de saison en bataille (remplace celui de seasons)." },
          "decor_saturation": { "type": "number", "minimum": 0, "maximum": 1, "description": "Part de saturation gardée par l'albédo du sol et de l'herbe (bible DA § 3.3)." }
        },
        "additionalProperties": false
      }
    },
    "campaign": {
      "type": "object",
      "properties": {
        "grade_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "seasons": {
          "type": "object",
          "propertyNames": { "enum": ["spring", "summer", "autumn", "winter"] },
          "additionalProperties": {
            "allOf": [{ "$ref": "#/$defs/sky_look" }],
            "type": "object",
            "properties": {
              "sky": { "type": "string" },
              "fog_color": { "$ref": "#/$defs/rgb" }
            },
            "required": ["sky", "sky_luminance"]
          }
        }
      },
      "required": ["grade_strength", "seasons"],
      "additionalProperties": false
    },
    "secondary_motion": {
      "type": "object",
      "description": "Lot AN1a (ADR 0096) : mouvement secondaire en shader de sommets des figurines de bataille (bas des surcots et jaques, caparaçons, crinières, queues) et des étendards portés. Rendu seulement. Le vent de base (direction, force, rafales) vient de data/fx/battle_finish.json (wind).",
      "properties": {
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "max_distance_m": { "type": "number", "minimum": 0, "maximum": 1000, "description": "Au-delà (m, caméra → soldat), aucun mouvement secondaire (coût)." },
        "speed_ref_m_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 20, "description": "Vitesse du régiment (m/s) qui donne le recul plein (plafonné à 1,5 fois)." },
        "wind_scale": { "type": "number", "minimum": 0, "maximum": 3, "description": "Multiplie la force du vent de la bataille." },
        "skirt": { "$ref": "#/$defs/motion_part" },
        "caparison": { "$ref": "#/$defs/motion_part" },
        "mane": { "$ref": "#/$defs/motion_part" },
        "tail": { "$ref": "#/$defs/motion_part" },
        "flag": {
          "type": "object",
          "description": "Étoffes des étendards portés (battle_standard_flag.gdshader).",
          "properties": {
            "amp_min": { "type": "number", "minimum": 0, "maximum": 1, "description": "Amplitude relative de l'onde par vent nul." },
            "amp_max": { "type": "number", "minimum": 0, "maximum": 1, "description": "Amplitude relative de l'onde par vent fort." },
            "wave_speed_min": { "type": "number", "minimum": 0, "maximum": 20, "description": "Vitesse de l'onde (rad/s) par vent nul." },
            "wave_speed_max": { "type": "number", "minimum": 0, "maximum": 30, "description": "Vitesse de l'onde (rad/s) par vent fort." },
            "ripple": { "type": "number", "minimum": 0, "maximum": 1, "description": "Ondulation le long de la hampe, relative à l'onde principale." },
            "gait_wind": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 4, "maxItems": 4, "description": "Vent apparent ajouté par l'allure du porteur, par clip du jeu (arrêt, marche, course, sonnerie)." }
          },
          "required": ["amp_min", "amp_max", "wave_speed_min", "wave_speed_max", "ripple", "gait_wind"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "max_distance_m", "speed_ref_m_s", "wind_scale", "skirt", "caparison", "mane", "tail", "flag"],
      "additionalProperties": false
    },
    "time_of_day": {
      "type": "object",
      "description": "Chantier PO (ADR 0097, bible DA § 12.6) : préréglages d'heure du jour (soleil et étalonnage). La bataille tire l'heure de sa graine (rendu seulement). Optionnel jusqu'aux lots PO3/PO4.",
      "propertyNames": { "enum": ["morning", "midday", "evening"] },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sun_elevation": { "type": "number", "minimum": 0, "maximum": 90, "description": "Degrés au-dessus de l'horizon." },
          "sun_azimuth": { "type": "number", "minimum": 0, "maximum": 360, "description": "Degrés depuis le nord, sens horaire." },
          "sun_color": { "$ref": "#/$defs/rgb" },
          "sun_energy": { "type": "number", "minimum": 0, "maximum": 4 },
          "grade": { "$ref": "#/$defs/grade" }
        },
        "required": ["sun_elevation", "sun_azimuth", "sun_color"]
      }
    }
  },
  "required": ["lut_size","skies", "seasons", "battle", "campaign"],
  "additionalProperties": false
}
