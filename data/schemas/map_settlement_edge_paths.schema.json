{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/map_settlement_edge_paths.schema.json",
  "title": "Settlement edge paths",
  "description": "Fichiers : map/settlement_edge_paths.json. Schéma initial dérivé des données existantes (ADR 0829) : types, clés requises et clés inconnues refusées ; à resserrer (bornes, énumérations) quand le champ est touché.",
  "type": "object",
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "from",
          "points",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "edges"
  ],
  "additionalProperties": false
}
