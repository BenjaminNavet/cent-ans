{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sea_basins.schema.json",
  "title": "Mers de la carte de campagne par bassin (TB5)",
  "description": "Réglages purement visuels des mers de la carte de campagne, lus par game/scripts/map/sea_basins.gd : bassins (polygones en pixels carte), teinte, clarté, houle, écume. Aucune règle de jeu.",
  "type": "object",
  "required": ["cell_px", "blur_cells", "depth", "swell", "whitecaps", "default", "basins"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "cell_px": {
      "description": "Taille d'une cellule de la texture des bassins, en pixels carte.",
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    },
    "blur_cells": {
      "description": "Fondu des limites de bassin, en cellules.",
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "swell": {
      "description": "Longue houle : longueur d'onde (pixels carte), vitesse, contraste de couleur, relief.",
      "type": "object",
      "required": ["length_px", "speed", "contrast", "ripple_contrast", "normal"],
      "additionalProperties": false,
      "properties": {
        "length_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 40},
        "speed": {"type": "number", "minimum": 0, "maximum": 5},
        "contrast": {"type": "number", "minimum": 0, "maximum": 1},
        "ripple_contrast": {
          "description": "Relief fin des vagues dans la couleur, sur toutes les mers.",
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "normal": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "depth": {
      "description": "Profondeur vue : exacte sous `soft_from_m[0]`, lissée (mip `soft_lod` de la carte d'altitude) au-delà de `soft_from_m[1]` ; `murk_m` : mètres d'eau ajoutés par unité de (1 / clarté - 1) dans une eau trouble.",
      "type": "object",
      "required": ["soft_lod", "soft_from_m", "murk_m"],
      "additionalProperties": false,
      "properties": {
        "soft_lod": {"type": "number", "minimum": 0, "maximum": 8},
        "soft_from_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0}
        },
        "murk_m": {"type": "number", "minimum": 0, "maximum": 200}
      }
    },
    "whitecaps": {
      "description": "Moutons : cellules par pixel carte en travers du vent, allongement dans le sens du vent, empreinte d'un pixel écran (pixels carte) entre lesquelles les crêtes s'effacent au dézoom, voile de teinte qui les remplace.",
      "type": "object",
      "required": ["cells_per_px", "stretch", "fade_footprint", "veil"],
      "additionalProperties": false,
      "properties": {
        "cells_per_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "stretch": {"type": "number", "minimum": 1, "maximum": 8},
        "fade_footprint": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}
        },
        "veil": {"type": "number", "minimum": 0, "maximum": 0.2}
      }
    },
    "default": {"$ref": "#/$defs/look"},
    "basins": {
      "description": "Quatre bassins au plus (un canal de la texture chacun).",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "look", "polygon_px"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "look": {"$ref": "#/$defs/look"},
          "polygon_px": {
            "description": "Polygone en pixels carte (grille de map.json), terres comprises.",
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "look": {
      "type": "object",
      "required": ["tint", "clarity", "swell", "long_swell", "foam", "whitecaps", "grey_scale"],
      "additionalProperties": false,
      "properties": {
        "tint": {
          "description": "Teinte multipliée à la couleur de l'eau (RVB linéaire).",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "minimum": 0, "maximum": 4}
        },
        "clarity": {"type": "number", "minimum": 0.1, "maximum": 5},
        "swell": {"type": "number", "minimum": 0, "maximum": 3},
        "long_swell": {"type": "number", "minimum": 0, "maximum": 1},
        "foam": {"type": "number", "minimum": 0, "maximum": 3},
        "whitecaps": {"type": "number", "minimum": 0, "maximum": 1},
        "grey_scale": {"type": "number", "minimum": 0, "maximum": 2}
      }
    }
  }
}
