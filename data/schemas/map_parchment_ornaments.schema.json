{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map_parchment_ornaments.schema.json",
  "title": "Ornements de portulan de la vue parchemin (lot FA6)",
  "description": "Catalogue `data/map/parchment_ornaments.json` : découpes d'ornements (rose des vents, navires, monstres marins) dans des numérisations d'œuvres du domaine public, lues par `tools/cent_ans_tools/parchment_ornaments.py` (détourage) et par `ParchmentDecor` (affichage). Coordonnées en pixels du fichier source.",
  "type": "object",
  "required": ["output_dir", "preview_colours", "use", "sources", "ornaments"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "output_dir": {"type": "string", "pattern": "^game/assets/textures/", "description": "Dossier des PNG produits, relatif à la racine du dépôt."},
    "preview_colours": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rgb255"}, "description": "Fonds de la planche de contrôle (`--preview`)."},
    "use": {
      "type": "object",
      "required": ["rose", "ship", "monster"],
      "additionalProperties": false,
      "description": "Choix par genre d'ornement, lu par `ParchmentDecor` : `real` = découpes du catalogue, `drawn` = dessin par code d'origine (et ses emplacements).",
      "properties": {
        "rose": {"$ref": "#/$defs/use"},
        "ship": {"$ref": "#/$defs/use"},
        "monster": {"$ref": "#/$defs/use"}
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["file", "title", "page_url", "download_url", "work", "author", "date", "institution", "licence"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "description": "Chemin de la numérisation brute, relatif au dossier des brutes (hors dépôt)."},
          "title": {"type": "string", "pattern": "^File:", "description": "Titre du fichier sur Wikimedia Commons."},
          "page_url": {"type": "string", "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:"},
          "download_url": {"type": "string", "pattern": "^https://upload\\.wikimedia\\.org/"},
          "work": {"type": "string", "minLength": 1},
          "author": {"type": "string", "minLength": 1},
          "date": {"type": "string", "minLength": 1},
          "institution": {"type": "string", "minLength": 1},
          "licence": {"type": "string", "pattern": "^Domaine public", "description": "Licence vérifiée sur la page du fichier (seul le domaine public est admis)."}
        }
      }
    },
    "ornaments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "note", "source", "file", "crop", "size", "mask", "display"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "kind": {"enum": ["rose", "ship", "monster"], "description": "Emplacement de `ParchmentDecor` auquel l'ornement est posé. `rose` : découpe carrée centrée, cercle de la rose à 0,9 du demi-côté, nord en haut (convention de `parchment_sea.gdshaderinc`)."},
          "note": {"type": "string", "minLength": 1, "description": "Sujet de la découpe (repris dans `SOURCE.md`)."},
          "source": {"type": "string", "description": "Clé de `sources`."},
          "file": {"type": "string", "pattern": "^[a-z0-9_]+\\.png$"},
          "crop": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}, "description": "Rectangle x0, y0, x1, y1."},
          "size": {"type": "integer", "minimum": 64, "maximum": 1024, "description": "Plus grand côté du PNG produit (px)."},
          "mask": {"$ref": "#/$defs/shape"},
          "key": {
            "type": "object",
            "required": ["low", "high"],
            "additionalProperties": false,
            "description": "Retrait du vélin : opacité = écart de couleur au papier local (sans `key`, le masque est opaque).",
            "properties": {
              "low": {"type": "number", "minimum": 0, "maximum": 1},
              "high": {"type": "number", "minimum": 0, "maximum": 1},
              "paper_radius": {"type": "integer", "minimum": 8, "description": "Demi-fenêtre de l'estimation du papier (px source)."},
              "percentile": {"type": "number", "minimum": 50, "maximum": 100},
              "reject_blue": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "Seuils bas et haut de l'excès de bleu rejeté (vagues des mers de l'Atlas)."},
              "reject_except": {"$ref": "#/$defs/shape", "description": "Zone où le bleu est peint à dessein et gardé."},
              "ink_gain": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "tone": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 2}},
          "saturation": {"type": "number", "minimum": 0, "maximum": 3},
          "contrast": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
          "opacity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "fills": {"type": "array", "items": {"$ref": "#/$defs/fill"}, "description": "Lavis posés sous l'encre (voile, coque) pour qu'une esquisse pâle se lise à la taille d'un ornement."},
          "display": {
            "type": "object",
            "required": ["anchor"],
            "additionalProperties": false,
            "properties": {
              "anchor": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}, "description": "Point de la découpe posé sur l'emplacement (0-1)."},
              "height": {"type": "number", "exclusiveMinimum": 0, "description": "Hauteur à l'écran, en unités du dessin de `ParchmentOverlay` (16 px pour un navire, 20 px pour un monstre, à la distance de référence)."},
              "faces": {"enum": ["left", "right"], "description": "Sens de la proue ou du regard dans la découpe (miroir selon le cap)."}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "use": {"enum": ["real", "drawn"]},
    "fill": {
      "type": "object",
      "required": ["shape", "points", "colour"],
      "additionalProperties": false,
      "properties": {
        "shape": {"const": "polygon"},
        "points": {"$ref": "#/$defs/polygon"},
        "feather": {"type": "number", "minimum": 0},
        "colour": {"$ref": "#/$defs/rgb255"},
        "opacity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "rgb255": { "$ref": "common.schema.json#/$defs/rgb255" },
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}},
    "shape": {
      "type": "object",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "shape": {"enum": ["disk", "polygon"]},
        "center": {"$ref": "#/$defs/point"},
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "points": {"$ref": "#/$defs/polygon"},
        "holes": {"type": "array", "items": {"$ref": "#/$defs/polygon"}},
        "feather": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"shape": {"const": "disk"}}}, "then": {"required": ["center", "radius"]}},
        {"if": {"properties": {"shape": {"const": "polygon"}}}, "then": {"required": ["points"]}}
      ]
    }
  }
}
