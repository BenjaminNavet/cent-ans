{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/ground_biome_mix.schema.json",
  "description": "Fichier data/art/ground_biome_mix.json (chantier HB, ADR 0143).",
  "type": "object",
  "required": [
    "biomes"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "biomes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "cell_m",
          "strip",
          "hedge",
          "farm",
          "crops",
          "wild",
          "canopy",
          "rock"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cell_m": {
            "type": "number",
            "minimum": 50,
            "maximum": 3000
          },
          "strip": {
            "type": "number",
            "minimum": 1,
            "maximum": 6
          },
          "hedge": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "farm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crops": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "wild": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "canopy": {
            "type": "string"
          },
          "rock": {
            "type": "string"
          },
          "tint": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 1.9
            }
          }
        },
        "additionalProperties": false
      }
    },
    "view": {
      "type": "object",
      "description": "ADR 0253 : lisibilité des champs peints (uniforms hb_* du sol) : fondu vers la carte de couleur (empreinte px carte / px écran), teinte gardée, variation par parcelle, couleur de culture à distance, haies minimales.",
      "properties": {
        "fade_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fade_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "hue_keep": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cell_jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cell_hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "far_hedge": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "open_farm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cell_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "parcels_source": {
      "enum": [
        "hb",
        "tx"
      ],
      "description": "Source du parcellaire : hb (matières fal.ai d'origine) ou tx (paquet tx_campaign_parcels, ADR 0243)."
    },
    "tx_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "description": "Champs d'un biome remplacés quand parcels_source vaut tx (matières régionales du paquet TX).",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
