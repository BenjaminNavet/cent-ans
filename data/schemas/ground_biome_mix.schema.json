{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/ground_biome_mix.schema.json",
  "description": "Fichier data/art/ground_biome_mix.json (chantier HB, ADR 0143).",
  "type": "object",
  "required": [
    "biomes"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "biomes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "cell_m",
          "strip",
          "hedge",
          "farm",
          "crops",
          "wild",
          "canopy",
          "rock"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cell_m": {
            "type": "number",
            "minimum": 50,
            "maximum": 3000
          },
          "strip": {
            "type": "number",
            "minimum": 1,
            "maximum": 6
          },
          "hedge": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "farm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crops": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "wild": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "canopy": {
            "type": "string"
          },
          "rock": {
            "type": "string"
          },
          "coteau_vine": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "GR (ADR 0352) : part des parcelles des coteaux exposés au sud plantées en vigne."
          },
          "tint": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 1.9
            }
          }
        },
        "additionalProperties": false
      }
    },
    "crop_far": {
      "type": "object",
      "description": "GR (ADR 0352) : couleur d'été lointaine (linéaire) et classe de saison (0 blé, 1 culture verte, 2 labour, 3 jachère, 4 pré, 5 foin, 6 culture pérenne) de chaque culture, matière ou repli.",
      "additionalProperties": {
        "type": "object",
        "required": ["color", "season"],
        "additionalProperties": false,
        "properties": {
          "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "season": {"type": "integer", "minimum": 0, "maximum": 6}
        }
      }
    },
    "geo": {
      "type": "object",
      "description": "GR (ADR 0352) : le relief et l'eau placent les cultures (estives, pentes, vigne de coteau, prés de fond de vallée).",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "vine_material": {"type": "string"},
        "meadow_material": {"type": "string"},
        "farm_alt_start": {
          "type": "number",
          "minimum": 0
        },
        "farm_alt_end": {
          "type": "number",
          "minimum": 0
        },
        "farm_slope_start": {
          "type": "number",
          "minimum": 0
        },
        "farm_slope_end": {
          "type": "number",
          "minimum": 0
        },
        "coteau_slope_min": {
          "type": "number",
          "minimum": 0
        },
        "coteau_slope_max": {
          "type": "number",
          "minimum": 0
        },
        "coteau_south": {
          "type": "number",
          "minimum": 0
        },
        "meadow_px": {
          "type": "number",
          "minimum": 0
        },
        "meadow_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "view": {
      "type": "object",
      "description": "ADR 0253 : lisibilité des champs peints (uniforms hb_* du sol) : fondu vers la carte de couleur (empreinte px carte / px écran), teinte gardée, variation par parcelle, couleur de culture à distance, haies minimales.",
      "properties": {
        "fade_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fade_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "hue_keep": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "lum_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "CS2 : écart de luminance relatif maximal d'une parcelle à la couleur locale de la carte."
        },
        "cell_jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cell_hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "far_hedge": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "open_farm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sole_scale": {"type": "number", "minimum": 0, "maximum": 2},
        "sole_share": {"type": "number", "minimum": 0, "maximum": 1},
        "far_gain": {"type": "number", "minimum": 0, "maximum": 2},
        "far_start": {"type": "number", "minimum": 0, "maximum": 10},
        "far_end": {"type": "number", "minimum": 0, "maximum": 10},
        "terroir_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "terroir_start": {"type": "number", "minimum": 0, "maximum": 10},
        "terroir_end": {"type": "number", "minimum": 0, "maximum": 10},
        "far_edge": {"type": "number", "minimum": 0, "maximum": 1},
        "patch_sat": {"type": "number", "minimum": 0, "maximum": 3},
        "cell_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "parcels_source": {
      "enum": [
        "hb",
        "tx"
      ],
      "description": "Source du parcellaire : hb (matières fal.ai d'origine) ou tx (paquet tx_campaign_parcels, ADR 0243)."
    },
    "tx_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "description": "Champs d'un biome remplacés quand parcels_source vaut tx (matières régionales du paquet TX).",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
