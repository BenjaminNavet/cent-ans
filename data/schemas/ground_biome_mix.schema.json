{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/ground_biome_mix.schema.json",
  "description": "Fichier data/art/ground_biome_mix.json (chantier HB, ADR 0143).",
  "type": "object",
  "required": [
    "biomes"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "biomes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "cell_m",
          "strip",
          "hedge",
          "farm",
          "crops",
          "wild",
          "canopy",
          "rock"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "form": {
            "enum": ["default", "openfield", "bocage", "midi", "montagne"],
            "description": "VIS-R3b : forme de parcellaire du biome (bloc `landscapes`)."
          },
          "cell_m": {
            "type": "number",
            "minimum": 50,
            "maximum": 3000
          },
          "strip": {
            "type": "number",
            "minimum": 1,
            "maximum": 6
          },
          "hedge": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "farm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crops": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "wild": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "canopy": {
            "type": "string"
          },
          "rock": {
            "type": "string"
          },
          "coteau_vine": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "GR (ADR 0352) : part des parcelles des coteaux exposés au sud plantées en vigne."
          },
          "tint": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 1.9
            }
          }
        },
        "additionalProperties": false
      }
    },
    "crop_far": {
      "type": "object",
      "description": "GR (ADR 0352) : couleur d'été lointaine (linéaire) et classe de saison (0 blé, 1 culture verte, 2 labour, 3 jachère, 4 pré, 5 foin, 6 culture pérenne) de chaque culture, matière ou repli.",
      "additionalProperties": {
        "type": "object",
        "required": ["color", "season"],
        "additionalProperties": false,
        "properties": {
          "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "season": {"type": "integer", "minimum": 0, "maximum": 6}
        }
      }
    },
    "geo": {
      "type": "object",
      "description": "GR (ADR 0352) : le relief et l'eau placent les cultures (estives, pentes, vigne de coteau, prés de fond de vallée).",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "vine_material": {"type": "string"},
        "meadow_material": {"type": "string"},
        "farm_alt_start": {
          "type": "number",
          "minimum": 0
        },
        "farm_alt_end": {
          "type": "number",
          "minimum": 0
        },
        "farm_slope_start": {
          "type": "number",
          "minimum": 0
        },
        "farm_slope_end": {
          "type": "number",
          "minimum": 0
        },
        "coteau_slope_min": {
          "type": "number",
          "minimum": 0
        },
        "coteau_slope_max": {
          "type": "number",
          "minimum": 0
        },
        "coteau_south": {
          "type": "number",
          "minimum": 0
        },
        "meadow_px": {
          "type": "number",
          "minimum": 0
        },
        "meadow_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "view": {
      "type": "object",
      "description": "ADR 0253 : lisibilité des champs peints (uniforms hb_* du sol) : fondu vers la carte de couleur (empreinte px carte / px écran), teinte gardée, variation par parcelle, couleur de culture à distance, haies minimales.",
      "properties": {
        "fade_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fade_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "hue_keep": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "lum_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "CS2 : écart de luminance relatif maximal d'une parcelle à la couleur locale de la carte."
        },
        "cell_jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cell_hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "patch_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "far_hedge": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "open_farm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sole_scale": {"type": "number", "minimum": 0, "maximum": 2},
        "sole_share": {"type": "number", "minimum": 0, "maximum": 1},
        "far_gain": {"type": "number", "minimum": 0, "maximum": 2},
        "far_start": {"type": "number", "minimum": 0, "maximum": 10},
        "far_end": {"type": "number", "minimum": 0, "maximum": 10},
        "terroir_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "terroir_start": {"type": "number", "minimum": 0, "maximum": 10},
        "terroir_end": {"type": "number", "minimum": 0, "maximum": 10},
        "far_edge": {"type": "number", "minimum": 0, "maximum": 1},
        "patch_sat": {"type": "number", "minimum": 0, "maximum": 3},
        "cell_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        },
        "lum_band_typed": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "VIS-R3b : écart de luminance relatif maximal d'une parcelle à la carte de couleur avec le parcellaire typé (lum_band sans)."
        },
        "colormap_near_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "VIS-R3b : part de la carte de couleur dans le sol au plus près (le sol texturé fait le reste) ; 1 à distance."
        },
        "strip_px": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 40},
          "minItems": 2,
          "maxItems": 2,
          "description": "VIS-L1 : largeur écran (px) d'une lanière en dessous de laquelle elle se fond dans le niveau de cellules plus grossier puis dans la carte de couleur (premier), au-dessus de laquelle elle est dessinée entière (second). [0, 0] : ancien fondu par empreinte."
        },
        "ground_look": {
          "type": "object",
          "description": "VIS-L1 : saturation, teinte et valeur de la végétation du sol, appliquées à l'albédo cuit (ground_look.wesl).",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "saturation": {"type": "number", "minimum": 0.5, "maximum": 4, "description": "Gain de chroma des teintes de végétation."},
            "hue_target_deg": {"type": "number", "minimum": 0, "maximum": 360, "description": "Teinte cible du pré (bible : 89)."},
            "hue_pull": {"type": "number", "minimum": 0, "maximum": 1, "description": "Part de l'écart de teinte corrigée."},
            "hue_pull_cold": {"type": "number", "minimum": 0, "maximum": 1, "description": "Part de l'écart corrigée pour les teintes plus bleues que la cible (menthe du bocage)."},
            "hue_cold_ramp_deg": {"type": "number", "minimum": 1, "maximum": 90, "description": "Écart (degrés) au bout duquel la correction froide est entière."},
            "plough_gain": {"type": "number", "minimum": 0.5, "maximum": 3, "description": "Gain de valeur (linéaire) du labour."},
            "stubble_gain": {"type": "number", "minimum": 0.5, "maximum": 3, "description": "Gain de valeur (linéaire) du chaume."},
            "hue_range_deg": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 360}, "minItems": 2, "maxItems": 2, "description": "Plage de teintes concernée (jaune-vert à vert-bleu)."},
            "forest_value": {"type": "number", "minimum": 0.1, "maximum": 1.5, "description": "Facteur de valeur (linéaire) des forêts."},
            "plain_value": {"type": "number", "minimum": 0.5, "maximum": 1.5, "description": "Facteur de valeur (linéaire) des terres ouvertes."}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "landscapes": {
      "type": "object",
      "description": "VIS-R3b (ADR XXXX) : formes de parcellaire typé, une par type de paysage.",
      "required": ["default", "openfield", "bocage", "midi", "montagne"],
      "properties": {
        "description": {"type": "string"},
        "default": {"$ref": "#/$defs/form"},
        "openfield": {"$ref": "#/$defs/form"},
        "bocage": {"$ref": "#/$defs/form"},
        "midi": {"$ref": "#/$defs/form"},
        "montagne": {"$ref": "#/$defs/form"}
      },
      "additionalProperties": false
    },
    "parcels_source": {
      "enum": [
        "hb",
        "tx"
      ],
      "description": "Source du parcellaire : hb (matières fal.ai d'origine) ou tx (paquet tx_campaign_parcels, ADR 0243)."
    },
    "tx_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-4])$"
      },
      "description": "Champs d'un biome remplacés quand parcels_source vaut tx (matières régionales du paquet TX).",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "form": {
      "type": "object",
      "required": ["aspect", "cell_scale", "warp", "brick", "len_var", "ring", "hedge_px", "hedge_range", "furrow", "reassign", "shares"],
      "additionalProperties": false,
      "properties": {
        "aspect": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 12}},
        "cell_scale": {"type": "number", "minimum": 0.2, "maximum": 3},
        "warp": {"type": "number", "minimum": 0, "maximum": 3},
        "brick": {"type": "number", "minimum": 0, "maximum": 1},
        "len_var": {"type": "number", "minimum": 0, "maximum": 1.8},
        "ring": {
          "type": "object",
          "required": ["strength", "thresholds", "min", "centers", "spread"],
          "additionalProperties": false,
          "properties": {
            "strength": {"type": "number", "minimum": 0, "maximum": 1},
            "thresholds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
            "min": {"type": "number", "minimum": 0, "maximum": 1},
            "centers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
            "spread": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "hedge_px": {"type": "number", "minimum": 0, "maximum": 4},
        "hedge_range": {"type": "number", "minimum": 0, "maximum": 4},
        "furrow": {
          "type": "object",
          "required": ["amp", "pitch_m", "range"],
          "additionalProperties": false,
          "properties": {
            "amp": {"type": "number", "minimum": 0, "maximum": 0.6},
            "pitch_m": {"type": "number", "minimum": 0.5, "maximum": 30},
            "range": {"type": "number", "minimum": 0, "maximum": 2}
          }
        },
        "reassign": {"type": "number", "minimum": 0, "maximum": 1},
        "shares": {
          "type": "object",
          "required": ["spring", "summer", "autumn", "winter"],
          "additionalProperties": false,
          "properties": {
            "spring": {"$ref": "#/$defs/season_shares"},
            "summer": {"$ref": "#/$defs/season_shares"},
            "autumn": {"$ref": "#/$defs/season_shares"},
            "winter": {"$ref": "#/$defs/season_shares"}
          }
        }
      }
    },
    "season_shares": {
      "type": "object",
      "description": "Poids relatifs (normalisés au chargement) des classes de season_field : wheat 0, green 1, ploughed 2, fallow 3, meadow 4, hay 5.",
      "required": ["wheat", "green", "ploughed", "fallow", "meadow", "hay"],
      "additionalProperties": false,
      "properties": {
        "wheat": {"type": "number", "minimum": 0},
        "green": {"type": "number", "minimum": 0},
        "ploughed": {"type": "number", "minimum": 0},
        "fallow": {"type": "number", "minimum": 0},
        "meadow": {"type": "number", "minimum": 0},
        "hay": {"type": "number", "minimum": 0}
      }
    }
  },
  "additionalProperties": false
}
