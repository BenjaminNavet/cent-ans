{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/ground_biome_mix.schema.json",
  "description": "Fichier data/art/ground_biome_mix.json (chantier HB, ADR 0143).",
  "type": "object",
  "required": ["biomes"],
  "properties": {
    "description": {"type": "string"},
    "biomes": {
      "type": "object",
      "propertyNames": {"pattern": "^[1-7]$"},
      "additionalProperties": {
        "type": "object",
        "required": ["cell_m", "strip", "hedge", "farm", "crops", "wild", "canopy", "rock"],
        "properties": {
          "name": {"type": "string"},
          "cell_m": {"type": "number", "minimum": 50, "maximum": 3000},
          "strip": {"type": "number", "minimum": 1, "maximum": 6},
          "hedge": {"type": "number", "minimum": 0, "maximum": 2},
          "farm": {"type": "number", "minimum": 0, "maximum": 1},
          "crops": {"type": "object", "minProperties": 1, "maxProperties": 12, "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
          "wild": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "canopy": {"type": "string"},
          "rock": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
