{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_campaign_terrain_textures.schema.json",
  "title": "Textures du terrain de campagne et de la mer (lot GA4)",
  "description": "Identité des couches des `Texture2DArray` du terrain de campagne (`terrain.gdshader`, `game/assets/textures/terrain/terrain_albedo_array.jpg` / `terrain_normal_array.jpg`), macro-variation et eau (`water.gdshader`). L'ordre de `layers` est l'ordre d'empilement et suit le contrat d'index fixe du shader (grass, farmland, forest, rock, heath, snow, sand) ; `TerrainBuilder` refuse un ordre différent. `mean_linear` : moyenne linéaire de l'albédo 2k, écrite par `cent-ans geo textures` (le shader teinte le détail autour de cette moyenne). Distances en pixels carte.",
  "type": "object",
  "required": ["albedo_size", "normal_size", "tile_screen_px", "layers", "macro", "water"],
  "additionalProperties": false,
  "$defs": {
    "role_map": {
      "type": "object",
      "propertyNames": {"enum": ["grass", "farmland", "forest", "rock", "heath", "snow", "sand"]},
      "additionalProperties": {"type": "string"}
    },
    "rgb": { "$ref": "common.schema.json#/$defs/rgb3" },
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
  },
  "properties": {
    "albedo_size": {"enum": [1024, 2048]},
    "normal_size": {"enum": [1024, 2048]},
    "tile_screen_px": {"type": "number", "minimum": 16, "maximum": 512},
    "layers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "poly_haven_id", "mean_linear"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["grass", "farmland", "forest", "rock", "heath", "snow", "sand"]},
          "poly_haven_id": { "$ref": "common.schema.json#/$defs/snake_id" },
          "mean_linear": {"$ref": "#/$defs/rgb"}
        }
      }
    },
    "regional": {
      "type": "object",
      "description": "TX (ADR 0239) : fond par biome. `roles` : rôle de la couche du shader (grass, farmland, forest, rock, heath, snow, sand) -> rôle du paquet `pack` (grass_bare, understory, rock, snow, sand, scree) ; `overrides` : par biome (1-14), rôles différents ; un biome sans couche d'un rôle prend celle de son parent. Fondu de `blend_km` entre deux biomes voisins (cartes `blend_ab` / `blend_dist` cuites par `cent-ans geo biome-blend`, un texel = `blend_texel_px` pixels carte).",
      "required": ["pack", "blend_km", "blend_ab", "blend_dist", "blend_texel_px", "roles"],
      "additionalProperties": false,
      "properties": {
        "pack": {"type": "string"},
        "blend_km": {"type": "number", "minimum": 0, "maximum": 100},
        "blend_ab": {"type": "string"},
        "blend_dist": {"type": "string"},
        "blend_texel_px": {"type": "integer", "minimum": 1},
        "min_blend_weight": {"type": "number", "minimum": 0, "maximum": 0.5},
        "hue_keep": {"type": "number", "minimum": 0, "maximum": 1, "description": "Part de la teinte propre d'une couche (relative à la moyenne des couches de même rôle) appliquée au fond : 0 = couleur de la carte seule."},
        "roles": {"$ref": "#/$defs/role_map"},
        "overrides": {
          "type": "object",
          "propertyNames": {"pattern": "^([1-9]|1[0-4])$"},
          "additionalProperties": {"$ref": "#/$defs/role_map"}
        }
      }
    },
    "micro": {
      "type": "object",
      "description": "TX : grain de sol fondu de près (ids du paquet `pack`, rôle micro_ground). `tile_m` : taille de la tuile au sol ; `fade_footprint` : empreinte (pixels carte par pixel écran) pleine force -> nulle ; `strength` : amplitude du grain en luminance.",
      "required": ["pack", "tile_m", "strength", "fade_footprint", "roles"],
      "additionalProperties": false,
      "properties": {
        "pack": {"type": "string"},
        "tile_m": {"type": "number", "exclusiveMinimum": 0},
        "strength": {"type": "number", "minimum": 0, "maximum": 1},
        "fade_footprint": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "roles": {"$ref": "#/$defs/role_map"}
      }
    },
    "macro": {
      "type": "object",
      "required": ["periods_px", "weights", "tint_amp", "lum_amp"],
      "additionalProperties": false,
      "properties": {
        "periods_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}},
        "weights": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
        "tint_amp": {"type": "number", "minimum": 0, "maximum": 4},
        "lum_amp": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "water": {
      "type": "object",
      "required": ["normal_size", "scale_a_px", "scale_b_px", "velocity_a_px", "velocity_b_px", "strength", "shallow_color", "mid_color", "deep_color", "mid_depth_m", "depth_falloff_m"],
      "additionalProperties": false,
      "properties": {
        "normal_size": {"enum": [512, 1024, 2048]},
        "scale_a_px": {"type": "number", "exclusiveMinimum": 0},
        "scale_b_px": {"type": "number", "exclusiveMinimum": 0},
        "velocity_a_px": {"$ref": "#/$defs/vec2"},
        "velocity_b_px": {"$ref": "#/$defs/vec2"},
        "strength": {"type": "number", "minimum": 0, "maximum": 2},
        "shallow_color": {"$ref": "#/$defs/rgb"},
        "mid_color": {"$ref": "#/$defs/rgb"},
        "deep_color": {"$ref": "#/$defs/rgb"},
        "mid_depth_m": {"type": "number", "exclusiveMinimum": 0},
        "depth_falloff_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
