{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_battle_animation.schema.json",
  "title": "Fondus et clips de rôle des figurines de bataille (NT7)",
  "type": "object",
  "required": ["cycle_blend_s", "role_clips"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "cycle_blend_s": {"type": "number", "minimum": 0.0, "maximum": 0.6},
    "role_blend_s": {"type": "number", "minimum": 0.0, "maximum": 0.6},
    "cavalry_gaits": {
      "type": "object",
      "required": ["trot_min_speed", "gallop_min_speed", "turn_min_rate"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "enabled": {"type": "boolean"},
        "trot_min_speed": {"type": "number", "exclusiveMinimum": 0.0},
        "gallop_min_speed": {"type": "number", "exclusiveMinimum": 0.0},
        "hysteresis_mps": {"type": "number", "minimum": 0.0, "maximum": 2.0},
        "turn_min_rate": {"type": "number", "exclusiveMinimum": 0.0},
        "turn_hysteresis": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "role_clips": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(standard|standard_mounted|drum|horn)$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "charging": {"type": "string", "minLength": 1},
            "victory": {"type": "string", "minLength": 1},
            "idle_alt": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
