{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building_models.schema.json",
  "title": "Bâtiments hors les murs de la carte de campagne (TB3)",
  "description": "Correspondance purement visuelle bâtiment construit → famille → niveau → maquette, lue par game/scripts/map/outbuilding_layer.gd. Aucune règle de jeu.",
  "type": "object",
  "required": [
    "version",
    "render",
    "families",
    "growth"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_range_units",
        "shadow_range_units",
        "exaggeration",
        "ring_min_m",
        "ring_max_m",
        "max_slope",
        "max_per_settlement",
        "shore_reach_m"
      ],
      "properties": {
        "view_range_units": {
          "description": "Distance du rig (unités monde, 1 u ≈ 719 m) au-delà de laquelle rien n'est dessiné.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shadow_range_units": {
          "description": "Distance du rig au-delà de laquelle les maquettes ne portent plus d'ombre.",
          "type": "number",
          "minimum": 0
        },
        "exaggeration": {
          "description": "Grossissement selon la distance du rig : 1 sous `full_size_below`, `max` au-delà de `max_above` (1 = échelle réelle partout, ADR 0138).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "full_size_below",
            "max_above"
          ],
          "properties": {
            "max": {
              "type": "number",
              "minimum": 1,
              "maximum": 40
            },
            "full_size_below": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_above": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "ring_min_m": {
          "description": "Distance minimale (m) entre le bord bâti de la colonie et une maquette.",
          "type": "number",
          "minimum": 0
        },
        "ring_max_m": {
          "description": "Distance maximale (m) au bord bâti.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_slope": {
          "description": "Pente maximale (m/m) d'un site.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_per_settlement": {
          "description": "Nombre maximal de maquettes autour d'une colonie.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "shore_reach_m": {
          "description": "Distance maximale (m) au bord bâti où chercher une grève (mer ou fleuve).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "farm",
        "mill",
        "vineyard",
        "mine",
        "saltworks",
        "abbey",
        "market",
        "port"
      ],
      "properties": {
        "farm": {
          "$ref": "#/$defs/family"
        },
        "mill": {
          "$ref": "#/$defs/family"
        },
        "vineyard": {
          "$ref": "#/$defs/family"
        },
        "mine": {
          "$ref": "#/$defs/family"
        },
        "saltworks": {
          "$ref": "#/$defs/family"
        },
        "abbey": {
          "$ref": "#/$defs/family"
        },
        "market": {
          "$ref": "#/$defs/family"
        },
        "port": {
          "$ref": "#/$defs/family"
        }
      }
    },
    "growth": {
      "description": "Croissance visible des villes 1:1 (faubourgs, enceinte).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suburbs",
        "enclosure"
      ],
      "properties": {
        "suburbs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population_step",
            "max_quarters",
            "houses_per_quarter",
            "frontage_m",
            "setback_m",
            "gap_m",
            "house_models"
          ],
          "properties": {
            "population_step": {
              "description": "Part de population de la province au-dessus de celle de 1337 qui ajoute un quartier.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_quarters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "houses_per_quarter": {
              "type": "integer",
              "minimum": 2,
              "maximum": 40
            },
            "frontage_m": {
              "description": "Largeur de parcelle le long de la route (m).",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "setback_m": {
              "description": "Recul des maisons par rapport à l'axe de la route (m).",
              "type": "number",
              "minimum": 0
            },
            "gap_m": {
              "description": "Intervalle (m) entre le bâti de 1340 et le premier quartier, puis entre quartiers.",
              "type": "number",
              "minimum": 0
            },
            "house_models": {
              "description": "Maisons du kit des villes (game/assets/models/town_kit/manifest.json).",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z]+_[0-9]+$"
              }
            }
          }
        },
        "enclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "margin_m",
            "sink_m",
            "gate_height_m",
            "kinds"
          ],
          "properties": {
            "margin_m": {
              "description": "Distance (m) de l'enceinte au bâti de 1340.",
              "type": "number",
              "minimum": 0
            },
            "sink_m": {
              "description": "Enfoncement (m) des pans dans le sol (pentes).",
              "type": "number",
              "minimum": 0
            },
            "gate_height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kinds": {
              "description": "Du plus faible au plus fort ; dimensions dans towns_1340.json (`walls`).",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "buildings"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "palisade",
                      "stone"
                    ]
                  },
                  "buildings": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^bld_[a-z0-9_]+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "site",
        "levels"
      ],
      "properties": {
        "name": {
          "description": "Nom français de la famille.",
          "type": "string",
          "minLength": 1
        },
        "site": {
          "description": "Site recherché : champ (le plus plat), rive d'un fleuve, côte (grève la plus proche, sinon champ), grève obligatoire (sinon rien), coteau, bord de la colonie.",
          "enum": [
            "field",
            "water",
            "coast",
            "shore",
            "slope",
            "road"
          ]
        },
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/level"
          }
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "model",
        "when"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "model": {
          "description": "Nom de la maquette (clé de game/assets/models/outbuildings/manifest.json).",
          "type": "string",
          "pattern": "^[a-z]+_[1-3]$"
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require"
          ],
          "properties": {
            "require": {
              "description": "Groupes tous exigés.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "of",
                  "min"
                ],
                "properties": {
                  "of": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^bld_[a-z0-9_]+$"
                    }
                  },
                  "min": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "resources": {
              "description": "La province doit produire au moins une de ces ressources.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^res_[a-z0-9_]+$"
              }
            }
          }
        }
      }
    }
  }
}
