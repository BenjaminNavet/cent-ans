{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/map_settlement_graph.schema.json",
  "title": "Settlement graph",
  "description": "Fichiers : map/settlement_graph.json. Schéma initial dérivé des données existantes (ADR 0829) : types, clés requises et clés inconnues refusées ; à resserrer (bornes, énumérations) quand le champ est touché.",
  "type": "object",
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "road": {
            "type": "boolean"
          },
          "sea": {
            "type": "boolean"
          }
        },
        "required": [
          "cost",
          "from",
          "road",
          "sea",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "edges"
  ],
  "additionalProperties": false
}
