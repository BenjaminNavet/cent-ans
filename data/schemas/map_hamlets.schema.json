{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/map_hamlets.schema.json",
  "title": "Hamlets",
  "description": "Fichiers : map/hamlets.json. Schéma initial dérivé des données existantes (ADR 0829) : types, clés requises et clés inconnues refusées ; à resserrer (bornes, énumérations) quand le champ est touché.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "px": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "province": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "province",
      "px"
    ],
    "additionalProperties": false
  }
}
