{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valley_courses.schema.json",
  "title": "Cours d'eau de grandes vallées (lot CC CS)",
  "type": "object",
  "required": ["description", "courses"],
  "additionalProperties": false,
  "$defs": {
    "lonlat_points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number"}
      }
    }
  },
  "properties": {
    "description": {"type": "string"},
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "lonlat"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "lonlat": {"$ref": "#/$defs/lonlat_points"},
          "scalerank": {"type": "integer", "minimum": 0, "description": "Rang d'échelle Natural Earth (défaut 4 dans valley_rivers.py)"},
          "width_px": {"type": "number", "exclusiveMinimum": 0, "description": "Largeur du fleuve en pixels carte (défaut 2.4)"},
          "clip_land": {"type": "boolean", "description": "Tracé découpé sur la terre (défaut : Euphrate et Tigre)"},
          "to_sea": {"type": "boolean", "description": "Prolongé jusqu'à la mer (défaut : noms commençant par « Nile (»)"}
        }
      }
    },
    "irrigated_areas": {
      "type": "array",
      "description": "Surfaces entièrement cultivées, lues par colormap.py (_course_features) ; anneau fermé implicite.",
      "items": {
        "type": "object",
        "required": ["name", "lonlat"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "lonlat": {"$ref": "#/$defs/lonlat_points", "minItems": 3}
        }
      }
    }
  }
}
