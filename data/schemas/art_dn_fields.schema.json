{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "art_dn_fields.schema.json",
  "title": "Champs en modèles 3D générés (lot DN-CHAMPS)",
  "description": "`data/art/dn_fields.json` : réglages de rendu et de placement de `FieldLayer` / `FieldPlan`, et table matière de sol -> modèles glb générés.",
  "type": "object",
  "required": ["render", "plan", "crops"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "enabled": {"type": "boolean", "description": "Faux : aucun modèle de parcelle posé, les champs restent peints dans le sol (rejet joueur 10-09)."},
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_range_units", "fade_from_units", "lod_distances", "load_factor", "load_min_units", "load_max_units", "cell_px", "max_instances", "plan_budget_ms", "rebuild_period_frames", "shadow_range_units", "albedo_gain", "sink_m"],
      "properties": {
        "view_range_units": {"type": "number", "exclusiveMinimum": 0},
        "fade_from_units": {"type": "number", "exclusiveMinimum": 0},
        "lod_distances": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2},
        "load_factor": {"type": "number", "exclusiveMinimum": 0},
        "load_min_units": {"type": "number", "exclusiveMinimum": 0},
        "load_max_units": {"type": "number", "exclusiveMinimum": 0},
        "cell_px": {"type": "number", "exclusiveMinimum": 0},
        "max_instances": {"type": "integer", "minimum": 0},
        "plan_budget_ms": {"type": "number", "minimum": 0},
        "rebuild_period_frames": {"type": "integer", "minimum": 1},
        "shadow_range_units": {"type": "number", "minimum": 0},
        "albedo_gain": {"type": "number", "exclusiveMinimum": 0},
        "sink_m": {"type": "number", "minimum": 0},
        "crop_style": {"enum": ["field", "closeup"], "description": "field : parcelle entière (`crops`) ; closeup : culture en gros plan répétée (`crops_closeup`), essai MX."}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parcel_px", "region_px", "dominant_share", "dominant_jitter", "cross_share", "forest_max", "farm_gain", "headland_px", "town_clear_px", "river_clear_px", "footprint_fill", "yaw_jitter", "size_jitter"],
      "properties": {
        "parcel_px": {"type": "number", "exclusiveMinimum": 0},
        "region_px": {"type": "number", "exclusiveMinimum": 0},
        "dominant_share": {"type": "number", "minimum": 0, "maximum": 1},
        "dominant_jitter": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_share": {"type": "number", "minimum": 0, "maximum": 1},
        "forest_max": {"type": "number", "minimum": 0, "maximum": 1},
        "farm_gain": {"type": "number", "minimum": 0},
        "headland_px": {"type": "number", "minimum": 0},
        "town_clear_px": {"type": "number", "minimum": 0},
        "river_clear_px": {"type": "number", "minimum": 0},
        "footprint_fill": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.5},
        "yaw_jitter": {"type": "number", "minimum": 0},
        "size_jitter": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "crops_closeup": {"$ref": "#/properties/crops"},
    "crops": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variants"],
        "properties": {
          "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
        }
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight"],
      "properties": {
        "id": {"type": "string", "pattern": "^(props|vegetation|buildings)/[a-z0-9_]+$"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "albedo_gain": {"type": "number", "exclusiveMinimum": 0, "description": "Gain d'albédo propre au modèle (1 = Meshy tel que généré, ADR 0349) ; défaut render.albedo_gain."},
        "min_lod": {"type": "integer", "minimum": 0, "maximum": 2, "description": "Niveau de détail le plus fin employé (modèle répété, LOD0 trop lourd)."},
        "tile": {"type": "integer", "minimum": 1, "maximum": 12, "description": "Gros plan : le modèle répété en tile x tile carreaux sur l'emprise de la parcelle."}
      }
    }
  }
}
