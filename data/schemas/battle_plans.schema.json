{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/battle_plans.schema.json",
  "title": "Plans de l'IA de bataille",
  "description": "Fichier data/rules/battle_plans.json (lot IA-PLAN-1) : plans par divisions lus par sim-battle (ai/planner).",
  "type": "object",
  "required": ["division_shares", "plans"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "division_shares": {
      "type": "object",
      "required": ["vanguard", "rear"],
      "additionalProperties": false,
      "description": "Parts des régiments (par profondeur au déploiement) qui forment l'avant-garde et l'arrière-garde ; le reste est la bataille.",
      "properties": {
        "vanguard": { "type": "number", "minimum": 0, "maximum": 1 },
        "rear": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "$defs": {
    "role": { "enum": ["hold", "shoot", "reserve"] },
    "condition": {
      "type": "object",
      "required": ["metric", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "time",
            "own_losses",
            "enemy_losses",
            "enemy_shooter_share",
            "enemy_has_stakes",
            "force_ratio",
            "enemy_distance"
          ],
          "description": "time : secondes simulées ; own_losses / enemy_losses : part des effectifs initiaux perdue ; enemy_shooter_share : part de la puissance ennemie en tireurs ; enemy_has_stakes : 1 si un régiment ennemi a planté ses pieux, sinon 0 ; force_ratio : puissance propre / ennemie ; enemy_distance : mètres jusqu'à l'ennemi le plus proche."
        },
        "op": { "enum": [">", ">=", "<", "<="] },
        "value": { "type": "number" }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name_fr", "roles", "enter", "exit"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name_fr": { "type": "string" },
        "roles": {
          "type": "object",
          "required": ["vanguard", "battle", "rear"],
          "additionalProperties": false,
          "properties": {
            "vanguard": { "$ref": "#/$defs/role" },
            "battle": { "$ref": "#/$defs/role" },
            "rear": { "$ref": "#/$defs/role" }
          }
        },
        "enter": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "exit": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "plan": {
      "type": "object",
      "required": ["id", "name_fr", "sides", "retarget_reach_m", "target_reach_m", "phases"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name_fr": { "type": "string" },
        "sides": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["attacker", "defender"] }
        },
        "retarget_reach_m": {
          "type": "number",
          "description": "Un régiment dont l'ordre d'attaque vise un autre ennemi que la cible de division est renvoyé sur celle-ci si elle est à moins de cette distance, sinon il tient."
        },
        "target_reach_m": {
          "type": "number",
          "description": "La cible de division est gardée tant qu'elle reste à moins de cette distance de la division."
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/phase" }
        }
      }
    }
  }
}
