{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encyclopedia.schema.json",
  "title": "Encyclopédie : fiches de l'onglet Mécaniques",
  "description": "Fiches explicatives de l'onglet « Mécaniques » de l'encyclopédie. Texte d'interface seulement ; les règles vivent dans core/. Le texte accepte les jetons {rule.<clé>} résolus par RuleValues.",
  "type": "object",
  "required": ["mechanics"],
  "additionalProperties": false,
  "properties": {
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "icon", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^mech_[a-z_]+$"},
          "name": {"type": "string", "minLength": 1},
          "icon": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "extra": {"type": "string", "enum": ["classes", "relations", "succession", "victory"], "description": "Complément tiré des données (Encyclopedia._mechanic_extra)."}
        }
      }
    }
  }
}
