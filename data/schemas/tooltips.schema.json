{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tooltips.schema.json",
  "title": "Textes des infobulles (IB)",
  "description": "Libellés et textes des infobulles (ADR 0109). Une entrée de type règle peut ouvrir sa propre bulle (lien ib:rule:<clé>).",
  "type": "object",
  "required": ["effects", "stats", "gauges", "hud", "plain"],
  "additionalProperties": false,
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "label": {"type": "string", "minLength": 1},
    "entry": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "hint": {"description": "Raccourci affiché en pied (« J », « Entrée »).", "type": "string"},
        "codex": {"description": "Fiche du Codex liée (cdx_…).", "type": "string", "pattern": "^cdx_[a-z0-9_]+$"}
      }
    },
    "rule_entry": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "body": {"description": "Texte de la bulle de règle (ib:rule:<clé>).", "type": "string"},
        "icon": {"type": "string"},
        "codex": {"type": "string", "pattern": "^cdx_[a-z0-9_]+$"}
      }
    }
  },
  "properties": {
    "description": {"type": "string"},
    "effects": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/rule_entry"}},
    "stats": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/rule_entry"}},
    "gauges": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/entry"}},
    "hud": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/entry"}},
    "plain": {"type": "object", "propertyNames": {"$ref": "#/$defs/key"}, "additionalProperties": {"$ref": "#/$defs/entry"}}
  }
}
