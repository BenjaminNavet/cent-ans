{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_campaign_army_walk.schema.json",
  "title": "Cadence de marche et balancement des étendards sur la carte (AS2)",
  "type": "object",
  "required": ["enabled", "cadence", "standard_sway"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "cadence": {
      "type": "object",
      "required": ["min_factor", "max_factor", "smoothing_per_s", "default_nominal_mps"],
      "additionalProperties": false,
      "properties": {
        "min_factor": {"type": "number", "minimum": 0.05, "maximum": 1.0},
        "max_factor": {"type": "number", "minimum": 1.0, "maximum": 4.0},
        "smoothing_per_s": {"type": "number", "minimum": 0.5, "maximum": 60.0},
        "default_nominal_mps": {"type": "number", "exclusiveMinimum": 0.0}
      }
    },
    "standard_sway": {
      "type": "object",
      "required": ["step_hz", "bob", "roll_deg", "lean_deg", "fade_per_s", "ship_tilt_gain", "cloth_gust"],
      "additionalProperties": false,
      "properties": {
        "step_hz": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 6.0},
        "bob": {"type": "number", "minimum": 0.0, "maximum": 0.5},
        "roll_deg": {"type": "number", "minimum": 0.0, "maximum": 20.0},
        "lean_deg": {"type": "number", "minimum": 0.0, "maximum": 20.0},
        "fade_per_s": {"type": "number", "minimum": 0.5, "maximum": 60.0},
        "ship_tilt_gain": {"type": "number", "minimum": 0.0, "maximum": 4.0},
        "cloth_gust": {"type": "number", "minimum": 0.0, "maximum": 3.0}
      }
    }
  }
}
