{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/naval_scenario.schema.json",
  "title": "Scénario de bataille navale",
  "description": "Fichier data/naval/scenarios/<id>.json (lot NV1) : bataille navale historique lançable seule (`--naval-scenario=<id>`). Positions en mètres, mer centrée sur 0 (x vers l'est) ; caps en degrés (0 = +x, 90 = +z).",
  "type": "object",
  "$defs": {
    "fleet": {
      "type": "object",
      "properties": {
        "faction": { "$ref": "common.schema.json#/$defs/faction_id" },
        "faction_name": { "type": "string" },
        "admiral": { "type": "string" },
        "hold": { "type": "boolean", "description": "La flotte reste à l'ancre (IA)." },
        "chains": {
          "type": "array",
          "description": "Lignes de navires enchaînés en formation défensive (lot NV2) : les navires d'un groupe `chain` sans `position` y sont rangés bord à bord, dans l'ordre du fichier.",
          "items": {
            "type": "object",
            "properties": {
              "chain": { "type": "integer", "minimum": 0 },
              "origin": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Centre de la ligne (m)." },
              "heading_deg": { "type": "number", "description": "Cap des navires ; la ligne court perpendiculairement." },
              "spacing_m": { "type": "number", "exclusiveMinimum": 0, "description": "Écart entre deux navires voisins (m)." }
            },
            "required": ["chain", "origin"],
            "additionalProperties": false
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "unit_type": { "$ref": "common.schema.json#/$defs/unit_type_id" },
              "name": { "type": "string" },
              "morale": { "type": "integer", "minimum": 0, "maximum": 100 },
              "experience": { "type": "integer", "minimum": 0, "maximum": 10 }
            },
            "required": ["unit_type"],
            "additionalProperties": false
          }
        },
        "ships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "class": { "type": "string", "pattern": "^ship_[a-z0-9_]+$" },
              "crew": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "unit": { "type": "integer", "minimum": 0 },
                    "men": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["unit", "men"],
                  "additionalProperties": false
                }
              },
              "fireship": { "type": "boolean" },
              "chain": { "type": "integer", "minimum": 0, "description": "Groupe de navires enchaînés en ligne." },
              "fire_arrows": { "type": "boolean" },
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "heading_deg": { "type": "number" },
              "flagship": { "type": "boolean" }
            },
            "required": ["name", "class", "crew"],
            "additionalProperties": false
          }
        }
      },
      "required": ["faction", "faction_name", "units", "ships"],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
    "place_name": { "type": "string" },
    "sea_zone": { "type": "string", "pattern": "^sea_[a-z0-9_]+$" },
    "season": { "enum": ["spring", "summer", "autumn", "winter"] },
    "rain": { "type": "boolean" },
    "wind_to_deg": { "type": "number" },
    "wind_strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "shore": { "type": "boolean" },
    "player_side": { "enum": ["attacker", "defender"] },
    "attacker": { "$ref": "#/$defs/fleet" },
    "defender": { "$ref": "#/$defs/fleet" },
    "description": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "name", "date", "place_name", "sea_zone", "attacker", "defender"],
  "additionalProperties": false
}
