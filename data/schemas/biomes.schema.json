{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biomes.schema.json",
  "title": "Légende et paramètres de la carte des biomes (chantier HB)",
  "description": "`data/map/biomes.yaml` : légende de `data/map/biomes.png` (indices figés 0-14 : 0-7 classes de base, 8-14 sous-classes régionales avec `parent`, ADR 0238) et seuils de sa cuisson par `cent-ans geo biomes` (`tools/cent_ans_tools/geo/biomes.py`, ADR 0143).",
  "type": "object",
  "required": [
    "classes",
    "source",
    "koppen",
    "rules",
    "refine",
    "smoothing",
    "fallback"
  ],
  "additionalProperties": false,
  "$defs": {
    "biome": {
      "enum": [
        "oceanic",
        "continental",
        "mediterranean",
        "steppe",
        "boreal",
        "mountain",
        "semi_arid"
      ]
    },
    "km": {
      "type": "number",
      "minimum": 0
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "box": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  },
  "properties": {
    "classes": {
      "type": "array",
      "description": "Indices figés : 0 mer, 1 océanique, 2 continental, 3 méditerranéen, 4 steppe, 5 boréal, 6 montagnard, 7 semi-aride ; 8 désert, 9 toundra, 10 continental est, 11 Atlantique sud, 12 pannonien, 13 hémiboréal, 14 maquis égéen (chacun avec `parent`, une classe de base).",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 0
            },
            "name": {
              "const": "sea"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 1
            },
            "name": {
              "const": "oceanic"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 2
            },
            "name": {
              "const": "continental"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 3
            },
            "name": {
              "const": "mediterranean"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 4
            },
            "name": {
              "const": "steppe"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 5
            },
            "name": {
              "const": "boreal"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 6
            },
            "name": {
              "const": "mountain"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 7
            },
            "name": {
              "const": "semi_arid"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 8
            },
            "name": {
              "const": "desert"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 9
            },
            "name": {
              "const": "tundra"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 10
            },
            "name": {
              "const": "continental_east"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 11
            },
            "name": {
              "const": "atlantic_south"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 12
            },
            "name": {
              "const": "pannonian"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 13
            },
            "name": {
              "const": "hemiboreal"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "const": 14
            },
            "name": {
              "const": "aegean_maquis"
            }
          }
        }
      ],
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "index",
          "name",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "$ref": "#/$defs/biome",
            "description": "Classe de base de repli (indices 8-14 seulement)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "index": {
                  "minimum": 8
                }
              },
              "required": [
                "index"
              ]
            },
            "then": {
              "required": [
                "parent"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "parent"
                ]
              }
            }
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "license",
        "url",
        "archive",
        "member",
        "codes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "archive": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]{1,2}$"
          }
        }
      }
    },
    "koppen": {
      "type": "object",
      "description": "Biome -> classes Köppen (avant ajustements).",
      "propertyNames": {
        "$ref": "#/$defs/biome"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "oceanic_max_km",
        "atlantic_boxes",
        "steppe_min_lat",
        "dry_min",
        "dry_noise_km",
        "dry_noise_amp",
        "dry_noise_seed",
        "forest_steppe",
        "coastal_semi_arid_km",
        "coastal_semi_arid_max_lon",
        "boreal_min_lat",
        "mountain"
      ],
      "additionalProperties": false,
      "properties": {
        "oceanic_max_km": {
          "$ref": "#/$defs/km"
        },
        "atlantic_boxes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        },
        "steppe_min_lat": {
          "$ref": "#/$defs/lat"
        },
        "dry_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dry_noise_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dry_noise_amp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dry_noise_seed": {
          "type": "integer",
          "minimum": 0
        },
        "forest_steppe": {
          "type": "object",
          "required": [
            "threshold",
            "line_max",
            "line_weight",
            "koppen_weights",
            "koppen_sigma_km",
            "lon_from",
            "lon_to",
            "noise",
            "seed"
          ],
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "line_max": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "line_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "koppen_weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "koppen_sigma_km": {
              "$ref": "#/$defs/km"
            },
            "lon_from": {
              "$ref": "#/$defs/lon"
            },
            "lon_to": {
              "$ref": "#/$defs/lon"
            },
            "noise": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "coastal_semi_arid_km": {
          "$ref": "#/$defs/km"
        },
        "coastal_semi_arid_max_lon": {
          "$ref": "#/$defs/lon"
        },
        "boreal_min_lat": {
          "$ref": "#/$defs/lat"
        },
        "mountain": {
          "type": "object",
          "required": [
            "base_m",
            "ref_lat",
            "per_deg_m",
            "dry_extra_m",
            "tundra_lowland"
          ],
          "additionalProperties": false,
          "properties": {
            "base_m": {
              "type": "number"
            },
            "ref_lat": {
              "$ref": "#/$defs/lat"
            },
            "per_deg_m": {
              "type": "number",
              "minimum": 0
            },
            "dry_extra_m": {
              "type": "number",
              "minimum": 0
            },
            "tundra_lowland": {
              "$ref": "#/$defs/biome"
            }
          }
        }
      }
    },
    "smoothing": {
      "type": "object",
      "required": [
        "sigma_km",
        "min_area_km2"
      ],
      "additionalProperties": false,
      "properties": {
        "sigma_km": {
          "$ref": "#/$defs/km"
        },
        "min_area_km2": {
          "$ref": "#/$defs/km"
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "mediterranean_max_lat",
        "semi_arid_coast_km",
        "semi_arid_max_lat"
      ],
      "additionalProperties": false,
      "properties": {
        "mediterranean_max_lat": {
          "$ref": "#/$defs/lat"
        },
        "semi_arid_coast_km": {
          "$ref": "#/$defs/km"
        },
        "semi_arid_max_lat": {
          "$ref": "#/$defs/lat"
        }
      }
    },
    "refine": {
      "type": "object",
      "description": "Sous-classes régionales 8-14 (ADR 0238), appliquées avant le lissage.",
      "required": [
        "edge_noise",
        "desert",
        "tundra",
        "hemiboreal",
        "pannonian",
        "atlantic_south",
        "aegean_maquis",
        "continental_east"
      ],
      "additionalProperties": false,
      "properties": {
        "edge_noise": {
          "type": "object",
          "required": [
            "km",
            "amp_deg",
            "seed"
          ],
          "additionalProperties": false,
          "properties": {
            "km": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "amp_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "desert": {
          "type": "object",
          "required": [
            "from",
            "koppen",
            "dryness_min"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "koppen": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z]{1,2}$"
              }
            },
            "dryness_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tundra": {
          "type": "object",
          "required": [
            "from",
            "koppen",
            "min_lat",
            "boreal_min_lat"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "koppen": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z]{1,2}$"
              }
            },
            "min_lat": {
              "$ref": "#/$defs/lat"
            },
            "boreal_min_lat": {
              "$ref": "#/$defs/lat"
            }
          }
        },
        "hemiboreal": {
          "type": "object",
          "required": [
            "from",
            "boxes"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/box"
              }
            }
          }
        },
        "pannonian": {
          "type": "object",
          "required": [
            "from",
            "boxes",
            "max_height_m"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/box"
              }
            },
            "max_height_m": {
              "type": "number"
            }
          }
        },
        "atlantic_south": {
          "type": "object",
          "required": [
            "from",
            "boxes",
            "max_height_m"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/box"
              }
            },
            "max_height_m": {
              "type": "number"
            }
          }
        },
        "aegean_maquis": {
          "type": "object",
          "required": [
            "from",
            "koppen",
            "boxes"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "koppen": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z]{1,2}$"
              }
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/box"
              }
            }
          }
        },
        "continental_east": {
          "type": "object",
          "required": [
            "from",
            "min_lon",
            "min_lat"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/biome"
              }
            },
            "min_lon": {
              "$ref": "#/$defs/lon"
            },
            "min_lat": {
              "$ref": "#/$defs/lat"
            }
          }
        }
      }
    }
  }
}
