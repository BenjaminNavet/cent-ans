{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/agent_rules.schema.json",
  "title": "Règles des agents de campagne",
  "description": "Fichier data/rules/agents.json (lot C6) : types d'agents (espion, héraut, prédicateur), recrutement, déplacement, actions et leurs chances, effets chiffrés. Voir docs/design/2026-09-24-agents.md.",
  "type": "object",
  "$defs": {
    "agent_type": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "cost": { "type": "integer", "minimum": 0 },
        "upkeep": { "type": "integer", "minimum": 0 },
        "max_per_faction": { "type": "integer", "minimum": 0, "maximum": 10 },
        "movement_steps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "vision_range": { "type": "integer", "minimum": 0, "maximum": 3 },
        "settlement_kinds": {
          "type": "array",
          "items": { "enum": ["city", "town", "castle", "abbey", "village"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "requires_religious_building": { "type": "boolean", "description": "Exige un bâtiment religieux dans la colonie (une abbaye en tient lieu)." },
        "names": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string" }
      },
      "required": ["name", "cost", "upkeep", "max_per_faction", "movement_steps", "settlement_kinds"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "base_chance": { "type": "integer", "minimum": 0, "maximum": 100 },
        "per_level": { "type": "integer", "minimum": 0, "maximum": 25 },
        "death_risk": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cost": { "type": "integer", "minimum": 0 },
        "description": { "type": "string" }
      },
      "required": ["name", "base_chance", "per_level"],
      "additionalProperties": false
    },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "properties": {
    "description": { "type": "string" },
    "types": {
      "type": "object",
      "properties": {
        "spy": { "$ref": "#/$defs/agent_type" },
        "emissary": { "$ref": "#/$defs/agent_type" },
        "preacher": { "$ref": "#/$defs/agent_type" }
      },
      "required": ["spy", "emissary", "preacher"],
      "additionalProperties": false
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "enum": ["scout", "sabotage", "incite", "counter", "parley", "truce", "bribe", "ransom", "preach", "denounce", "curia"]
      },
      "additionalProperties": { "$ref": "#/$defs/action" },
      "minProperties": 11
    },
    "experience_thresholds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 4,
      "maxItems": 4,
      "description": "Expérience requise pour les sceaux 2, 3, 4 et 5."
    },
    "xp_success": { "type": "integer", "minimum": 0 },
    "xp_failure": { "type": "integer", "minimum": 0 },
    "min_chance": { "$ref": "#/$defs/percent" },
    "max_chance": { "$ref": "#/$defs/percent" },
    "fortification_malus": { "type": "integer", "minimum": 0, "maximum": 20 },
    "counter_spy_malus": { "type": "integer", "minimum": 0, "maximum": 50 },
    "counter_spy_malus_per_level": { "type": "integer", "minimum": 0, "maximum": 20 },
    "counter_spy_malus_cap": { "$ref": "#/$defs/percent" },
    "passive_counter_base": { "$ref": "#/$defs/percent" },
    "passive_counter_per_level": { "type": "integer", "minimum": 0, "maximum": 30 },
    "passive_counter_cap": { "$ref": "#/$defs/percent" },
    "ai_network_min_income": { "type": "integer", "minimum": 0, "description": "Lot F8 : revenu de saison sous lequel une faction IA ne garde qu'un espion en temps de guerre, comme une puissance mineure (0 : toute faction jouable entretient un agent de chaque sorte)." },
    "effects": {
      "type": "object",
      "properties": {
        "intel_turns": { "type": "integer", "minimum": 1, "maximum": 20 },
        "sabotage_breach": { "$ref": "#/$defs/percent" },
        "sabotage_supplies": { "$ref": "#/$defs/percent" },
        "sabotage_delay_turns": { "type": "integer", "minimum": 0, "maximum": 10 },
        "sabotage_morale": { "$ref": "#/$defs/percent" },
        "incite_unrest": { "$ref": "#/$defs/percent" },
        "parley_opinion": { "type": "integer", "minimum": 0, "maximum": 50 },
        "parley_opinion_per_level": { "type": "integer", "minimum": 0, "maximum": 10 },
        "parley_turns": { "type": "integer", "minimum": 1, "maximum": 40 },
        "truce_turns": { "type": "integer", "minimum": 1, "maximum": 40 },
        "bribe_base_cost": { "type": "integer", "minimum": 0 },
        "bribe_cost_per_man_percent": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "bribe_men_per_malus": { "type": "integer", "minimum": 1 },
        "bribe_fail_opinion": { "type": "integer", "minimum": -50, "maximum": 0 },
        "ransom_price_percent": { "$ref": "#/$defs/percent" },
        "ransom_price_per_level": { "type": "integer", "minimum": 0, "maximum": 20 },
        "ransom_price_floor": { "$ref": "#/$defs/percent" },
        "preach_heresy": { "$ref": "#/$defs/percent" },
        "preach_heresy_per_level": { "type": "integer", "minimum": 0, "maximum": 20 },
        "preach_unrest": { "$ref": "#/$defs/percent" },
        "denounce_clergy_unrest": { "$ref": "#/$defs/percent" },
        "denounce_peasant_unrest": { "$ref": "#/$defs/percent" },
        "denounce_favor": { "$ref": "#/$defs/percent" },
        "curia_favor": { "$ref": "#/$defs/percent" },
        "curia_favor_per_level": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    }
  },
  "required": ["types", "actions", "experience_thresholds"],
  "additionalProperties": false
}
