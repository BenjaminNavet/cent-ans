{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/agri_landscapes.schema.json",
  "title": "Paysages agricoles régionaux (ME8)",
  "description": "Fichier data/map/agri_landscapes.json : paysages de parcellaire (openfields, bocage, vignes en terrasses, oliveraies, huertas, brûlis), leurs régions en ellipses lon/lat et les variantes saisonnières d'arbres. Lu par tools/cent_ans_tools/geo/agri_regions.py (cuisson de agri_regions.png) et game/scripts/map/hb_ground.gd. Rendu seulement.",
  "type": "object",
  "required": [
    "landscapes",
    "regions"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "landscapes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "cell_m",
          "strip",
          "hedge",
          "farm",
          "open_to_farm",
          "crops",
          "wild",
          "canopy",
          "rock"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "cell_m": {
            "type": "number",
            "minimum": 50,
            "maximum": 3000
          },
          "strip": {
            "type": "number",
            "minimum": 1,
            "maximum": 6
          },
          "hedge": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "farm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "open_to_farm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crops": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "wild": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "canopy": {
            "type": "string"
          },
          "rock": {
            "type": "string"
          },
          "tint": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.5
            }
          }
        }
      }
    },
    "material_fallbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "landscape",
          "ellipse"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "landscape": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ellipse": {
            "$ref": "#/$defs/ellipse"
          }
        }
      }
    },
    "seasonal_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tree_class",
          "season",
          "model_id"
        ],
        "properties": {
          "tree_class": {
            "enum": [
              "oak",
              "beech",
              "evergreen",
              "golden"
            ]
          },
          "season": {
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter"
            ]
          },
          "model_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "lonlat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -11,
          "maximum": 61
        },
        {
          "type": "number",
          "minimum": 28,
          "maximum": 66
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ellipse": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "#/$defs/lonlat"
        },
        "radii_km": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "center",
        "radii_km"
      ],
      "additionalProperties": false
    }
  }
}