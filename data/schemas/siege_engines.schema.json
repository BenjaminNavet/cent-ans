{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siege_engines.schema.json",
  "title": "Engins de siège animés (SG2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "models_dir",
    "engines",
    "trebuchet",
    "mangonel",
    "bombard",
    "ram",
    "siege_tower",
    "oil",
    "impact_marks"
  ],
  "$defs": {
    "crew_clip": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "angle": {
      "type": "number",
      "minimum": -720,
      "maximum": 720
    },
    "phase": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "properties": {
    "description": {
      "type": "string"
    },
    "models_dir": {
      "type": "string",
      "pattern": "^res://.+/$"
    },
    "engines": {
      "type": "object",
      "propertyNames": {
        "pattern": "^unit_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "enum": [
          "trebuchet",
          "mangonel",
          "bombard"
        ]
      }
    },
    "trebuchet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cocked_deg",
        "rest_deg",
        "overswing_deg",
        "swing_s",
        "release_phase",
        "sling_release_deg",
        "sling_end_deg",
        "sling_power",
        "settle_s",
        "settle_hz",
        "settle_damping",
        "counterweight_lag",
        "winch_turns",
        "ready_margin_s",
        "stagger_s",
        "predict"
      ],
      "properties": {
        "cocked_deg": {
          "$ref": "#/$defs/angle"
        },
        "rest_deg": {
          "$ref": "#/$defs/angle"
        },
        "overswing_deg": {
          "$ref": "#/$defs/angle"
        },
        "swing_s": {
          "$ref": "#/$defs/positive"
        },
        "release_phase": {
          "$ref": "#/$defs/phase"
        },
        "sling_release_deg": {
          "$ref": "#/$defs/angle"
        },
        "sling_end_deg": {
          "$ref": "#/$defs/angle"
        },
        "sling_power": {
          "$ref": "#/$defs/positive"
        },
        "settle_s": {
          "$ref": "#/$defs/seconds"
        },
        "settle_hz": {
          "$ref": "#/$defs/positive"
        },
        "settle_damping": {
          "$ref": "#/$defs/seconds"
        },
        "counterweight_lag": {
          "$ref": "#/$defs/seconds"
        },
        "winch_turns": {
          "$ref": "#/$defs/seconds"
        },
        "ready_margin_s": {
          "$ref": "#/$defs/seconds"
        },
        "stagger_s": {
          "$ref": "#/$defs/seconds"
        },
        "predict": {
          "type": "boolean"
        },
        "swing_curve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "lut"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "measured_swing_s": {
              "$ref": "#/$defs/positive"
            },
            "measured_arc_deg": {
              "$ref": "#/$defs/positive"
            },
            "measured_vertical_phase": {
              "$ref": "#/$defs/phase"
            },
            "lut": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.2
              },
              "description": "Part de l'arc (0 armé, 1 fin du dépassement) à phases régulières 0..1 du basculement ; interpolée linéairement."
            }
          }
        }
      }
    },
    "mangonel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cocked_deg",
        "fired_deg",
        "swing_s",
        "release_phase",
        "bounce_deg",
        "settle_s",
        "winch_turns",
        "ready_margin_s",
        "stagger_s",
        "predict"
      ],
      "properties": {
        "cocked_deg": {
          "$ref": "#/$defs/angle"
        },
        "fired_deg": {
          "$ref": "#/$defs/angle"
        },
        "swing_s": {
          "$ref": "#/$defs/positive"
        },
        "release_phase": {
          "$ref": "#/$defs/phase"
        },
        "bounce_deg": {
          "$ref": "#/$defs/angle"
        },
        "settle_s": {
          "$ref": "#/$defs/seconds"
        },
        "winch_turns": {
          "$ref": "#/$defs/seconds"
        },
        "ready_margin_s": {
          "$ref": "#/$defs/seconds"
        },
        "stagger_s": {
          "$ref": "#/$defs/seconds"
        },
        "predict": {
          "type": "boolean"
        }
      }
    },
    "bombard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoil_m",
        "recoil_s",
        "hold_s",
        "return_s",
        "mantlet_raised_deg",
        "mantlet_s",
        "stagger_s",
        "smoke_scale"
      ],
      "properties": {
        "recoil_m": {
          "$ref": "#/$defs/seconds"
        },
        "recoil_s": {
          "$ref": "#/$defs/positive"
        },
        "hold_s": {
          "$ref": "#/$defs/seconds"
        },
        "return_s": {
          "$ref": "#/$defs/positive"
        },
        "mantlet_raised_deg": {
          "$ref": "#/$defs/angle"
        },
        "mantlet_s": {
          "$ref": "#/$defs/positive"
        },
        "stagger_s": {
          "$ref": "#/$defs/seconds"
        },
        "smoke_scale": {
          "$ref": "#/$defs/positive"
        },
        "flash_s": {
          "$ref": "#/$defs/positive"
        },
        "smoke_s": {
          "$ref": "#/$defs/positive"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel_radius",
        "beam_drop",
        "max_swing_deg",
        "sway_deg",
        "sway_per_m"
      ],
      "properties": {
        "wheel_radius": {
          "$ref": "#/$defs/positive"
        },
        "beam_drop": {
          "$ref": "#/$defs/positive"
        },
        "max_swing_deg": {
          "$ref": "#/$defs/angle"
        },
        "sway_deg": {
          "$ref": "#/$defs/seconds"
        },
        "sway_per_m": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "siege_tower": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel_radius",
        "model_height",
        "bridge_above_wall",
        "sway_deg",
        "sway_per_m"
      ],
      "properties": {
        "wheel_radius": {
          "$ref": "#/$defs/positive"
        },
        "model_height": {
          "$ref": "#/$defs/positive"
        },
        "bridge_above_wall": {
          "type": "number"
        },
        "sway_deg": {
          "$ref": "#/$defs/seconds"
        },
        "sway_per_m": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "ga3": {
      "type": "object",
      "description": "GA3-L5 : variantes générées des modèles animés (engin -> {model, réglages remplacés}). Absent : modèles procéduraux seuls.",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "trebuchet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "wheel_radius": {
              "$ref": "#/$defs/positive"
            },
            "beam_drop": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "mangonel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "wheel_radius": {
              "$ref": "#/$defs/positive"
            },
            "beam_drop": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "bombard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "wheel_radius": {
              "$ref": "#/$defs/positive"
            },
            "beam_drop": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "ram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "wheel_radius": {
              "$ref": "#/$defs/positive"
            },
            "beam_drop": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "siege_tower": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "wheel_radius": {
              "$ref": "#/$defs/positive"
            },
            "beam_drop": {
              "$ref": "#/$defs/positive"
            }
          }
        }
      }
    },
    "oil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steam_amount",
        "steam_lifetime_s",
        "steam_rise",
        "steam_size_m",
        "drip_amount",
        "drip_lifetime_s",
        "stain_width_m",
        "stain_seconds",
        "sound_delay_s"
      ],
      "properties": {
        "steam_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "steam_lifetime_s": {
          "$ref": "#/$defs/positive"
        },
        "steam_rise": {
          "$ref": "#/$defs/seconds"
        },
        "steam_size_m": {
          "$ref": "#/$defs/positive"
        },
        "drip_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "drip_lifetime_s": {
          "$ref": "#/$defs/positive"
        },
        "stain_width_m": {
          "$ref": "#/$defs/positive"
        },
        "stain_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "sound_delay_s": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "impact_marks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_marks",
        "size_m",
        "depth_m",
        "breach_scale"
      ],
      "properties": {
        "max_marks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "size_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positive"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "depth_m": {
          "$ref": "#/$defs/positive"
        },
        "breach_scale": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "crew": {
      "type": "object",
      "description": "SG3 : servants des engins (figurines skinnées V2 crew_0 sans arme, crew_1 avec refouloir), placés autour de chaque modèle (x, z en mètres dans le repère du modèle, cap en degrés, 0 = face à +Z) ; rôle -> clip selon le rechargement du cœur (treuil, chargement, écouvillon) ou le déplacement (poussée). Cachés au-delà de hide_beyond_m (distance des imposteurs BV3).",
      "properties": {
        "figure_kind": {
          "type": "string"
        },
        "detail_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "medium_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "hide_beyond_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "load_from": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Part du treuil accomplie dès laquelle le chargeur du trébuchet charge la pierre."
        },
        "swab_until": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Part du rechargement de la bombarde pendant laquelle le servant écouvillonne et refoule."
        },
        "bombard_load": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Part du rechargement de la bombarde pendant laquelle le chargeur apporte la poudre et le boulet."
        },
        "clips": {
          "type": "object",
          "description": "Clip par rôle ; NT7 : une liste alterne les gestes d'un servant à l'autre.",
          "additionalProperties": {
            "$ref": "#/$defs/crew_clip"
          }
        },
        "clips_by_engine": {
          "type": "object",
          "description": "NT7 : surcharge des clips de rôle par type d'engin (ex. chargeur de trébuchet).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/crew_clip"
            }
          }
        },
        "layouts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "yaw_deg": {
                  "type": "number"
                },
                "role": {
                  "enum": [
                    "winch",
                    "loader",
                    "swab",
                    "pusher"
                  ]
                },
                "figure": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "rest": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Place de repos (x, z, cap en degrés) quand le servant ne travaille pas : hors du souffle de la bouche."
                }
              },
              "required": [
                "x",
                "z",
                "yaw_deg",
                "role",
                "figure"
              ],
              "additionalProperties": false
            }
          }
        },
        "haul": {
          "type": "object",
          "description": "AS4 : servants porteurs. Un servant va chercher une pierre, un boulet ou un baril de poudre à un tas placé près de l'engin, le porte (clip carry, sinon walk, objet tenu en main), revient et charge, calé sur la phase de rechargement de l'engin (0 : vient de tirer, 1 : prêt). Rendu seulement.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "walk_clip": {
              "type": "string"
            },
            "carry_clip": {
              "type": "string"
            },
            "grab_clip": {
              "type": "string"
            },
            "drop_clip": {
              "type": "string"
            },
            "objects": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "shape": {
                    "enum": [
                      "sphere",
                      "cylinder"
                    ]
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  },
                  "y_scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "shape",
                  "radius",
                  "color"
                ],
                "additionalProperties": false
              }
            },
            "by_engine": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "piles": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "object": {
                          "type": "string"
                        },
                        "x": {
                          "type": "number"
                        },
                        "z": {
                          "type": "number"
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 16
                        },
                        "spread": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 3
                        }
                      },
                      "required": [
                        "object",
                        "x",
                        "z",
                        "count",
                        "spread"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "haulers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pile": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "post": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3,
                          "description": "x, z, cap en degrés du poste de chargement."
                        },
                        "figure": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "trip": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "minItems": 5,
                          "maxItems": 5,
                          "description": "Phases croissantes : départ, arrivée au tas, saisie finie, retour au poste, charge finie."
                        },
                        "hold": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3,
                          "description": "Position de l'objet porté dans le repère du servant (x, y, z)."
                        }
                      },
                      "required": [
                        "pile",
                        "post",
                        "figure",
                        "trip",
                        "hold"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "piles",
                  "haulers"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "enabled",
            "walk_clip",
            "carry_clip",
            "grab_clip",
            "drop_clip",
            "objects",
            "by_engine"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "figure_kind",
        "detail_m",
        "medium_m",
        "hide_beyond_m",
        "load_from",
        "swab_until",
        "bombard_load",
        "clips",
        "layouts"
      ],
      "additionalProperties": false
    },
    "lod": {
      "type": "object",
      "description": "SG3 : niveaux de détail des engins. Au-delà de simple_m, maillage simplifié (<modèle>_lod.glb, pièces animées gardées) ; au-delà de far_m (même distance que les imposteurs de figurines BV3), pose recalculée far_pose_hz fois par seconde seulement et servants cachés. Lisible par les préréglages de qualité (SiegeEnginesFx.lod_distances()).",
      "properties": {
        "simple_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "far_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "far_pose_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      },
      "required": [
        "simple_m",
        "far_m",
        "far_pose_hz"
      ],
      "additionalProperties": false
    }
  }
}
