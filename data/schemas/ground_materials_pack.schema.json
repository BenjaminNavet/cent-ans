{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground_materials_pack.schema.json",
  "title": "Manifeste du tableau de matières de sol (HB2, généré)",
  "description": "Écrit par `cent-ans assets ground-materials pack` : correspondance id → couche des tableaux `hb_ground_albedo_array.jpg` / `hb_ground_normal_array.jpg` et moyenne linéaire de chaque albédo. Lu par `game/scripts/map/ground_materials.gd` (le jeu ne lit pas le YAML).",
  "type": "object",
  "required": ["layer_size", "grid", "albedo", "normal", "layers"],
  "additionalProperties": false,
  "properties": {
    "layer_size": {"type": "integer", "minimum": 64},
    "grid": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2
    },
    "albedo": {"type": "string", "pattern": "^res://"},
    "normal": {"type": "string", "pattern": "^res://"},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layer", "role", "biomes", "tile_m", "mean_linear"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "layer": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "enum": ["crop", "canopy", "ground"]},
          "biomes": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}},
          "tile_m": {"type": "number"},
          "mean_linear": {
            "type": "array",
            "items": {"type": "number", "minimum": 0, "maximum": 1},
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  }
}
