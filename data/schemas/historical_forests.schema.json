{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/historical_forests.schema.json",
  "title": "Grandes forêts vers 1340",
  "description": "Fichier data/map/historical_forests.json (lot R1) : grandes forêts et landes nommées de la carte de campagne vers 1340, en ellipses ou polygones approximatifs (lon/lat WGS84). Lu par tools/cent_ans_tools/geo/landcover.py qui en fait des massifs dans splat.png (canal B) ; aucune règle de jeu.",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/area" }
    }
  },
  "required": ["areas"],
  "additionalProperties": false,
  "$defs": {
    "lonlat": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -11, "maximum": 61 },
        { "type": "number", "minimum": 28, "maximum": 66 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ellipse": {
      "type": "object",
      "properties": {
        "center": { "$ref": "#/$defs/lonlat" },
        "radii_km": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "Demi-axes (km) : le premier orienté selon angle_deg."
        },
        "angle_deg": { "type": "number", "minimum": -180, "maximum": 180, "description": "Orientation du premier axe, degrés depuis l'est, sens trigonométrique." }
      },
      "required": ["center", "radii_km"],
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1, "description": "Nom en français (nom médiéval entre parenthèses si utile)." },
        "kind": {
          "enum": ["broadleaf", "mixed", "conifer", "heath"],
          "description": "Feuillus, mixte, résineux (sapinières, pinèdes) ou lande (couverture ouverte : fait baisser la forêt)."
        },
        "density": { "type": "number", "minimum": 0, "maximum": 1, "description": "Part boisée visée à l'intérieur (lande : part de lande)." },
        "ellipse": { "$ref": "#/$defs/ellipse" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/lonlat" }
        },
        "source": { "type": "string", "minLength": 1, "description": "Référence vérifiable (ouvrage, article, notice)." },
        "note": { "type": "string" }
      },
      "required": ["id", "name", "kind", "density", "source"],
      "oneOf": [
        { "required": ["ellipse"] },
        { "required": ["polygon"] }
      ],
      "additionalProperties": false
    }
  }
}
