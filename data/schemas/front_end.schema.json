{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "front_end.schema.json",
  "title": "Écrans d'accueil (MM1)",
  "description": "Décor 3D du menu principal, présentation des factions jouables, dates de départ, introduction et écrans de chargement (citations, conseils, illustrations). Rendu et textes seulement.",
  "type": "object",
  "required": [
    "backdrop",
    "start_dates",
    "factions",
    "difficulty_labels",
    "intro",
    "loading"
  ],
  "additionalProperties": false,
  "$defs": {
    "res_path": {
      "type": "string",
      "pattern": "^res://.+\\.(jpg|png|glb)$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 4
      },
      "minItems": 3,
      "maxItems": 3
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "camera_key": {
      "type": "object",
      "required": [
        "position",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        }
      }
    }
  },
  "properties": {
    "description": {
      "type": "string"
    },
    "backdrop": {
      "type": "object",
      "description": "Décor 3D du menu : ville emblématique au crépuscule, plans de caméra enchaînés en fondu, ost au premier plan.",
      "required": [
        "model",
        "sky",
        "shots",
        "shot_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "landmark": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/res_path"
        },
        "sky": {
          "type": "string",
          "description": "Identifiant de ciel de data/fx/atmosphere.json (skies)."
        },
        "sky_luminance": {
          "type": "number",
          "minimum": 0
        },
        "sky_saturation": {
          "type": "number",
          "minimum": 0
        },
        "sky_tint": {
          "$ref": "#/$defs/rgb"
        },
        "sun_elevation_deg": {
          "type": "number",
          "minimum": -10,
          "maximum": 90
        },
        "sun_energy": {
          "type": "number",
          "minimum": 0
        },
        "sun_color": {
          "$ref": "#/$defs/rgb"
        },
        "fog_color": {
          "$ref": "#/$defs/rgb"
        },
        "fog_density": {
          "type": "number",
          "minimum": 0
        },
        "ground_color": {
          "$ref": "#/$defs/rgb"
        },
        "shot_seconds": {
          "type": "number",
          "exclusiveMinimum": 2
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "from": {
                "$ref": "#/$defs/camera_key"
              },
              "to": {
                "$ref": "#/$defs/camera_key"
              },
              "fov": {
                "type": "number",
                "minimum": 10,
                "maximum": 100
              },
              "host": {
                "type": "boolean"
              }
            }
          }
        },
        "host": {
          "type": "object",
          "required": [
            "center",
            "regiments"
          ],
          "additionalProperties": false,
          "properties": {
            "center": {
              "$ref": "#/$defs/vec3"
            },
            "facing_deg": {
              "type": "number"
            },
            "regiments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "variant",
                  "faction",
                  "offset",
                  "files",
                  "ranks",
                  "spacing"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "infantry",
                      "archer",
                      "cavalry"
                    ]
                  },
                  "variant": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "faction": {
                    "type": "string",
                    "pattern": "^fac_"
                  },
                  "offset": {
                    "$ref": "#/$defs/vec2"
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "ranks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "spacing": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "banner": {
                    "type": "string",
                    "pattern": "\\.png$"
                  }
                }
              }
            }
          }
        },
        "countryside": {
          "type": "object",
          "additionalProperties": false,
          "description": "Campagne autour de la maquette : Seine prolongée, bosquets, zones sans arbres (rectangles x0, z0, x1, z1).",
          "properties": {
            "river_z": {
              "type": "number"
            },
            "river_half_width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "seed": {
              "type": "integer"
            },
            "groves": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400
            },
            "keep_out": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "meadow_zone": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "grass": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rect",
                "count"
              ],
              "properties": {
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                }
              }
            }
          }
        }
      }
    },
    "start_dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "year",
          "title",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1300,
            "maximum": 1500
          },
          "season": {
            "type": "string"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tagline",
          "intro",
          "strengths",
          "weaknesses",
          "difficulty"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fac_"
          },
          "tagline": {
            "$ref": "#/$defs/text"
          },
          "intro": {
            "$ref": "#/$defs/text"
          },
          "strengths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "difficulty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Indice dans difficulty_labels."
          },
          "illustration": {
            "$ref": "#/$defs/res_path"
          }
        }
      }
    },
    "difficulty_labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "intro": {
      "type": "object",
      "required": [
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "string"
        },
        "card_seconds": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "date",
              "title",
              "text",
              "illustration"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "$ref": "#/$defs/text"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "illustration": {
                "$ref": "#/$defs/res_path"
              }
            }
          }
        }
      }
    },
    "loading": {
      "type": "object",
      "required": [
        "illustrations",
        "quotes",
        "tips"
      ],
      "additionalProperties": false,
      "properties": {
        "illustrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/res_path"
          },
          "minItems": 1
        },
        "faction_illustrations": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/res_path"
            }
          }
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text",
              "author",
              "date"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "author": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "type": "string"
              },
              "date": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "tips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      }
    }
  }
}
