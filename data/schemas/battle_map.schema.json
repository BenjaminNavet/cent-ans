{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cent-ans.game/schemas/battle_map.schema.json",
  "title": "Carte de bataille historique",
  "description": "Bataille historique jouable (lot EP7, ADR 0035) : site réel (relief tiré du MNT Copernicus par `cent-ans geo battle-site`, bois, marais, ruisseaux, chemins, haies, décor d'époque EP6), ordres de bataille régiment par régiment, vagues successives, régiments tenant leur position, météo et heure de départ. Coordonnées du champ en mètres : x de 0 à la largeur, z de 0 (bord de l'attaquant) à la profondeur ; l'avance de l'attaquant (+z) pointe vers `site.bearing_deg`. Lu par sim-battle (`historical::HistoricalMap`).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "coord": { "type": "number", "minimum": -500, "maximum": 6000 },
    "point": {
      "type": "array",
      "items": { "$ref": "#/$defs/coord" },
      "minItems": 2,
      "maxItems": 2
    },
    "polyline": {
      "type": "array",
      "items": { "$ref": "#/$defs/point" },
      "minItems": 2
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z", "radius"],
      "properties": {
        "x": { "$ref": "#/$defs/coord" },
        "z": { "$ref": "#/$defs/coord" },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1500 }
      }
    },
    "weather": { "enum": ["clear", "rain", "fog", "snow"] },
    "side": { "enum": ["attacker", "defender"] },
    "army": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faction", "faction_name", "regiments"],
      "properties": {
        "faction": { "type": "string", "pattern": "^fac_[a-z_]+$" },
        "faction_name": { "type": "string", "minLength": 1 },
        "army": { "type": "string" },
        "general": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "regiment", "command"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "character": { "type": "string" },
            "regiment": { "type": "integer", "minimum": 0, "description": "Indice du régiment du chef, en comptant les régiments bloc après bloc." },
            "command": { "type": "integer", "minimum": 0, "maximum": 10 },
            "sovereign": { "type": "boolean" },
            "morale_bonus": { "type": "number", "minimum": -30, "maximum": 30 },
            "charge_percent": { "type": "number", "minimum": -50, "maximum": 50 },
            "ranged_percent": { "type": "number", "minimum": -50, "maximum": 50 },
            "defense_percent": { "type": "number", "minimum": -50, "maximum": 50 }
          }
        },
        "regiments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_type", "x", "z", "facing_deg"],
            "properties": {
              "unit_type": { "type": "string", "pattern": "^unit_[a-z_]+$" },
              "count": { "type": "integer", "minimum": 1, "maximum": 40, "description": "Régiments du bloc, côte à côte le long du front." },
              "soldiers": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "x": { "$ref": "#/$defs/coord" },
              "z": { "$ref": "#/$defs/coord" },
              "facing_deg": { "type": "number", "minimum": -360, "maximum": 360, "description": "Orientation : 0 = +z (vers le défenseur), 180 = vers l'attaquant." },
              "gap_m": { "type": "number", "minimum": 0, "maximum": 200 },
              "wave": { "type": "integer", "minimum": 0, "description": "Indice de la vague (« bataille ») de l'armée." },
              "hold": { "type": "boolean", "description": "Tient sa position : l'IA ne l'éloigne pas de plus de leash_m." },
              "leash_m": { "type": "number", "minimum": 0, "maximum": 2000 },
              "formation": { "enum": ["line", "column", "square", "wedge"] },
              "dismounted": { "type": "boolean" },
              "morale": { "type": "integer", "minimum": 1, "maximum": 100 },
              "experience": { "type": "integer", "minimum": 0, "maximum": 10 },
              "ammo": { "type": "integer", "minimum": 0, "maximum": 200 },
              "label": { "type": "string" }
            }
          }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string" },
              "release_s": { "type": "number", "minimum": 0, "maximum": 3600 },
              "after": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "required": [
    "id", "name", "date", "year", "province", "province_name", "terrain", "season", "site",
    "field", "weather", "start_hour", "armies", "historical_winner"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^1[34][0-9]{2}-[01][0-9]-[0-3][0-9]$" },
    "year": { "type": "integer", "minimum": 1300, "maximum": 1500 },
    "summary": { "type": "string" },
    "province": { "type": "string", "pattern": "^prov_[a-z_]+$" },
    "province_name": { "type": "string" },
    "terrain": { "enum": ["plains", "hills", "mountains", "forest", "marsh", "heath", "bocage"] },
    "season": { "enum": ["spring", "summer", "autumn", "winter"] },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon", "lat", "bearing_deg", "place"],
      "properties": {
        "lon": { "type": "number", "minimum": -10, "maximum": 20 },
        "lat": { "type": "number", "minimum": 35, "maximum": 60 },
        "bearing_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "place": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_m", "depth_m", "line_gap_m", "zone_depth_m", "max_regiments_per_side"],
      "properties": {
        "width_m": { "type": "number", "minimum": 1200, "maximum": 3200 },
        "depth_m": { "type": "number", "minimum": 800, "maximum": 2400 },
        "line_gap_m": { "type": "number", "minimum": 200, "maximum": 1500 },
        "zone_depth_m": { "type": "number", "minimum": 200, "maximum": 1000 },
        "max_regiments_per_side": { "type": "integer", "minimum": 10, "maximum": 120 }
      }
    },
    "relief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_m", "nx", "nz", "heights_dm"],
      "properties": {
        "step_m": { "type": "number", "minimum": 5, "maximum": 100 },
        "nx": { "type": "integer", "minimum": 2 },
        "nz": { "type": "integer", "minimum": 2 },
        "base_m": { "type": "number" },
        "vertical_scale": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "heights_dm": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 30000 } },
        "source": { "type": "string" }
      }
    },
    "ground": { "enum": ["dry", "muddy", "snowy"] },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "$ref": "#/$defs/weather" },
        "label": { "type": "string" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_s", "weather"],
            "properties": {
              "at_s": { "type": "number", "minimum": 0, "maximum": 7200 },
              "weather": { "$ref": "#/$defs/weather" }
            }
          }
        }
      }
    },
    "start_hour": { "type": "number", "minimum": 0, "maximum": 24 },
    "woods": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "mud": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "pools": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "points", "width"],
        "properties": {
          "kind": { "enum": ["tributary", "brook"] },
          "points": { "$ref": "#/$defs/polyline" },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 40 }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "points", "width"],
        "properties": {
          "kind": { "enum": ["main", "track"] },
          "points": { "$ref": "#/$defs/polyline" },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "b", "kind"],
        "properties": {
          "a": { "$ref": "#/$defs/point" },
          "b": { "$ref": "#/$defs/point" },
          "kind": { "enum": ["hedge", "fence", "ditch"] }
        }
      }
    },
    "decor": { "$ref": "battle_decor_plan.schema.json" },
    "armies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attacker", "defender"],
      "properties": {
        "attacker": { "$ref": "#/$defs/army" },
        "defender": { "$ref": "#/$defs/army" }
      }
    },
    "historical_winner": { "$ref": "#/$defs/side" },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_year", "to_year"],
      "properties": {
        "from_year": { "type": "integer", "minimum": 1300, "maximum": 1500 },
        "to_year": { "type": "integer", "minimum": 1300, "maximum": 1500 }
      }
    },
    "horizon": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
