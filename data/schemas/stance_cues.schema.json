{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stance_cues.schema.json",
  "title": "Signes de relation de la carte de campagne (EN)",
  "description": "Couleurs et marques qui distinguent ennemis, amis et neutres sur la carte de campagne hors mode Diplomatie (ADR 0155) : frontières, plaques et anneaux d'armée, noms de ville. Rendu seulement.",
  "type": "object",
  "required": ["categories", "border", "army", "town"],
  "additionalProperties": false,
  "$defs": {
    "color": { "$ref": "common.schema.json#/$defs/color_hex" },
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {"enum": ["self", "enemy", "friend", "other"]},
    "plate_look": {
      "type": "object",
      "required": ["fill", "border", "ink"],
      "additionalProperties": false,
      "properties": {
        "fill": {"$ref": "#/$defs/color"},
        "border": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"}
      }
    },
    "plate_pastille": {
      "type": "object",
      "required": ["color", "min_rank"],
      "additionalProperties": false,
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "min_rank": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "plate": {
      "type": "object",
      "required": ["color", "width_px"],
      "additionalProperties": false,
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "width_px": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "ring": {
      "type": "object",
      "required": ["color", "alpha", "emission"],
      "additionalProperties": false,
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "alpha": {"$ref": "#/$defs/unit"},
        "emission": {"type": "number", "minimum": 0, "maximum": 2}
      }
    }
  },
  "properties": {
    "description": {"type": "string"},
    "categories": {
      "type": "object",
      "description": "Position diplomatique du cœur (self, ally, agreement, neutral, tension, war, vassal) → catégorie de signe ; les positions absentes sont « other ».",
      "required": ["self", "war"],
      "additionalProperties": {"$ref": "#/$defs/category"}
    },
    "border": {
      "type": "object",
      "description": "Couleur du trait de frontière par catégorie ; « other » garde la couleur héraldique, assourdie.",
      "required": ["self", "enemy", "friend", "enemy_focus", "other"],
      "additionalProperties": false,
      "properties": {
        "self": {"$ref": "#/$defs/color"},
        "enemy": {"$ref": "#/$defs/color"},
        "friend": {"$ref": "#/$defs/color"},
        "enemy_focus": {"$ref": "#/$defs/unit", "description": "Poids de pleine intensité des frontières ennemies quand la carte est au repos (TB2) : 1 = toujours pleines."},
        "other": {
          "type": "object",
          "required": ["saturation_scale", "saturation_max", "value_min", "value_max"],
          "additionalProperties": false,
          "properties": {
            "saturation_scale": {"$ref": "#/$defs/unit", "description": "Facteur appliqué à la saturation héraldique."},
            "saturation_max": {"$ref": "#/$defs/unit", "description": "Plafond de saturation : un rouge héraldique en paix ne doit pas se lire comme un ennemi."},
            "value_min": {"$ref": "#/$defs/unit"},
            "value_max": {"$ref": "#/$defs/unit"}
          }
        }
      }
    },
    "army": {
      "type": "object",
      "required": ["enemy_glyph", "plate", "ring"],
      "additionalProperties": false,
      "properties": {
        "enemy_glyph": {"type": "string", "maxLength": 2, "description": "Marque non colorée des armées ennemies sur la plaque d'effectif (daltonisme)."},
        "plate": {
          "type": "object",
          "description": "Bordure de la plaque d'effectif par catégorie.",
          "required": ["self", "enemy", "friend", "other"],
          "additionalProperties": false,
          "properties": {
            "self": {"$ref": "#/$defs/plate"},
            "enemy": {"$ref": "#/$defs/plate"},
            "friend": {"$ref": "#/$defs/plate"},
            "other": {"$ref": "#/$defs/plate"}
          }
        },
        "ring": {
          "type": "object",
          "description": "Anneau au sol des armées non sélectionnées ; catégories absentes : couleur héraldique.",
          "additionalProperties": false,
          "properties": {
            "enemy": {"$ref": "#/$defs/ring"},
            "friend": {"$ref": "#/$defs/ring"}
          }
        }
      }
    },
    "fog_memory": {
      "type": "object",
      "description": "WH hover (ADR 0271) : mémoire d'une armée ennemie perdue de vue. Éphémère (UI seulement, hors sauvegarde).",
      "required": ["turns", "ghost_alpha"],
      "additionalProperties": false,
      "properties": {
        "turns": {"type": "integer", "minimum": 0, "maximum": 20, "description": "Saisons (tours) pendant lesquelles le fantôme reste affiché ; 0 = pas de mémoire."},
        "ghost_alpha": {"$ref": "#/$defs/unit", "description": "Opacité du jeton fantôme grisé."}
      }
    },
    "zoc": {
      "type": "object",
      "description": "WH hover (ADR 0271) : zones de contrôle des armées ennemies visibles pendant qu'une armée du joueur est sélectionnée.",
      "required": ["max_rings", "color", "alpha"],
      "additionalProperties": false,
      "properties": {
        "max_rings": {"type": "integer", "minimum": 1, "maximum": 32},
        "color": {"$ref": "#/$defs/color", "description": "Rouge réservé aux ennemis (ADR 0155)."},
        "alpha": {"$ref": "#/$defs/unit", "description": "Opacité de l'anneau fin ; le disque de fond est à 12 % de cette valeur d'anneau."}
      }
    },
    "town": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "object",
          "description": "Encre du nom des villes par catégorie du détenteur ; catégories absentes : encre ordinaire.",
          "additionalProperties": false,
          "properties": {
            "enemy": {"$ref": "#/$defs/color"},
            "friend": {"$ref": "#/$defs/color"}
          }
        },
        "plate": {
          "type": "object",
          "description": "TS-T6 : cartouche de ville (fond, liseré, encre par position du détenteur) et pastilles d'information.",
          "required": ["fill_alpha", "border_px", "status", "pastilles"],
          "additionalProperties": false,
          "properties": {
            "description": {"type": "string"},
            "fill_alpha": {"$ref": "#/$defs/unit"},
            "border_px": {"type": "number", "minimum": 0, "maximum": 6},
            "status": {
              "type": "object",
              "required": ["self", "ally", "neutral", "enemy"],
              "additionalProperties": false,
              "properties": {
                "self": {"$ref": "#/$defs/plate_look"},
                "ally": {"$ref": "#/$defs/plate_look"},
                "neutral": {"$ref": "#/$defs/plate_look"},
                "enemy": {"$ref": "#/$defs/plate_look"}
              }
            },
            "pastilles": {
              "type": "object",
              "required": ["max", "size_px", "siege", "garrison", "buildings"],
              "additionalProperties": false,
              "properties": {
                "max": {"type": "integer", "minimum": 0, "maximum": 3},
                "size_px": {"type": "number", "minimum": 8, "maximum": 40},
                "siege": {"$ref": "#/$defs/plate_pastille"},
                "garrison": {"$ref": "#/$defs/plate_pastille"},
                "buildings": {"$ref": "#/$defs/plate_pastille"}
              }
            }
          }
        }
      }
    }
  }
}
