  "zones": [
    { "id": "rhin_superieur", "kind": "divagating", "name": "Rhin supérieur (Bâle - Mayence)", "flags": ["divagating", "rectified"], "polygon_lonlat": [[7.45, 47.55], [7.75, 47.5], [8.05, 48.35], [8.45, 49.0], [8.6, 49.6], [8.45, 50.05], [8.15, 50.05], [8.25, 49.5], [8.05, 48.95], [7.65, 48.3], [7.45, 47.8]], "note": "Avant la correction de Tulla (1817-1876), le Rhin supérieur formait une plaine de tresses et de bras morts de 2 à 4 km de large ; le chenal moderne est rectifié et raccourci d'environ 80 km.", "source": "fr.wikipedia.org/wiki/Johann_Gottfried_Tulla ; de.wikipedia.org/wiki/Rheinbegradigung" },
    { "id": "rhin_inferieur", "kind": "divagating", "name": "Rhin inférieur et delta (Bonn - Nimègue - Dordrecht)", "flags": ["divagating"], "polygon_lonlat": [[7.1, 50.75], [7.3, 50.75], [6.9, 51.5], [6.3, 51.95], [5.6, 52.0], [4.6, 51.85], [4.55, 51.7], [5.3, 51.75], [6.1, 51.75], [6.7, 51.3]], "note": "Delta du Rhin et de la Meuse sans canaux ni coupures modernes (Pannerdensch Kanaal 1707, Nieuwe Merwede 1870, Bergsche Maas 1904) ; digues annulaires achevées vers le milieu du XIVᵉ s. ; la Grote Waard, noyée en 1421 (Biesbosch), est encore une terre habitée en 1340.", "source": "nl.wikipedia.org/wiki/Sint-Elisabethsvloed_(1421) ; nl.wikipedia.org/wiki/Grote_of_Zuid-Hollandse_Waard" },
    { "id": "rhone_aval", "kind": "divagating", "name": "Rhône aval et delta (Lyon - Camargue)", "flags": ["divagating", "rectified"], "polygon_lonlat": [[4.75, 45.8], [4.95, 45.8], [4.9, 45.0], [4.85, 44.3], [4.95, 43.9], [4.95, 43.35], [4.3, 43.35], [4.55, 43.9], [4.6, 44.3], [4.7, 45.0]], "note": "Rhône non endigué (digues Girardon et aménagements CNR aux XIXᵉ-XXᵉ s.), îles et lônes mobiles ; le delta de 1340 diffère du trait moderne (Rhône de Saint-Ferréol, bras actif à l'ouest).", "source": "fr.wikipedia.org/wiki/Rhône_(fleuve) ; fr.wikipedia.org/wiki/Delta_du_Rhône" },
    { "id": "loire_moyenne", "kind": "divagating", "name": "Loire moyenne (Nevers - Angers)", "flags": ["divagating"], "polygon_lonlat": [[3.2, 47.05], [3.05, 46.95], [2.4, 47.55], [1.9, 47.95], [1.3, 47.65], [0.5, 47.35], [-0.6, 47.4], [-0.55, 47.55], [0.5, 47.5], [1.3, 47.8], [1.95, 48.05], [2.55, 47.65]], "note": "Lit à bras multiples et grèves mouvantes ; les turcies (levées) existent par tronçons depuis Henri II Plantagenêt mais ne forment pas encore un endiguement continu (achevé aux XVᵉ-XVIIᵉ s.).", "source": "fr.wikipedia.org/wiki/Levée_de_la_Loire" },
    { "id": "durance_allier", "kind": "divagating", "name": "Durance et Allier (lits en tresses)", "flags": ["divagating"], "polygon_lonlat": [[4.8, 43.9], [5.1, 43.75], [5.95, 44.0], [6.1, 44.4], [6.0, 44.5], [5.8, 44.15], [5.1, 43.85]], "note": "Rivières en tresses, très mobiles avant les barrages et extractions du XXᵉ s.", "source": "fr.wikipedia.org/wiki/Durance" },
    { "id": "fens", "kind": "wetland", "name": "Fens (Cambridgeshire, Lincolnshire, Norfolk)", "flags": ["wetland", "rectified"], "polygon_lonlat": [[-0.35, 52.25], [0.45, 52.25], [0.55, 52.55], [0.35, 52.95], [-0.05, 53.05], [-0.4, 52.75]], "note": "Marais non drainés avant Vermuyden (1630-1653) ; rivières divagantes (Ouse, Nene, Welland), îles (Ely, Ramsey, Thorney) ; les drains rectilignes modernes sont exclus.", "source": "en.wikipedia.org/wiki/The_Fens ; en.wikipedia.org/wiki/Draining_of_the_Fens" },
    { "id": "hatfield_chase", "kind": "wetland", "name": "Hatfield Chase et île d'Axholme", "flags": ["wetland", "rectified"], "polygon_lonlat": [[-1.1, 53.45], [-0.7, 53.45], [-0.65, 53.7], [-1.05, 53.7]], "note": "Marais drainés par Vermuyden en 1626 ; la Don se jetait alors en plusieurs bras dans l'Aire et la Trent.", "source": "en.wikipedia.org/wiki/Hatfield_Chase" },
