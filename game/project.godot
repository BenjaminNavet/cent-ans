[shader_globals]

battle_water_light={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
campaign_season={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
campaign_roof_snow={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
landmark_albedo_array={
"type": "sampler2DArray",
"value": "res://assets/textures/landmarks/landmark_albedo_array.jpg"
}
landmark_normal_array={
"type": "sampler2DArray",
"value": "res://assets/textures/landmarks/landmark_normal_array.jpg"
}
campaign_parchment={
"type": "float",
"value": 0.0
}
campaign_vertical_scale={
"type": "float",
"value": 0.006
}
campaign_prop_scale={
"type": "float",
"value": 1.0
}
campaign_relief_gain={
"type": "float",
"value": 0.0
}
campaign_relief_squash={
"type": "float",
"value": 0.0
}
