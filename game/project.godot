; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cent Ans"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

MapPaths="*res://scripts/map/map_paths.gd"
SimFacade="*res://scripts/sim/sim_facade.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
IconLibrary="*res://scripts/ui/icon_library.gd"
Settings="*res://scripts/ui/settings.gd"
CodexStore="*res://scripts/codex/codex_store.gd"
CodexBubbles="*res://scripts/codex/codex_bubbles.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900

