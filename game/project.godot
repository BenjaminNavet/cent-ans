; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cent Ans"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="Cent Ans"
run/main_scene="res://scenes/start_menu.tscn"
boot_splash/bg_color=Color(0.16, 0.12, 0.08, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

HeadlessWatchdog="*res://scripts/debug/headless_watchdog.gd"
MapPaths="*res://scripts/map/map_paths.gd"
SimFacade="*res://scripts/sim/sim_facade.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
IconLibrary="*res://scripts/ui/icon_library.gd"
Settings="*res://scripts/ui/settings.gd"
CodexStore="*res://scripts/codex/codex_store.gd"
CodexBubbles="*res://scripts/codex/codex_bubbles.gd"
UiLayout="*res://scripts/ui/ui_layout.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900

