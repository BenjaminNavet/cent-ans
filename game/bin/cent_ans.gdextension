[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug.arm64 = "res://bin/libcent_ans.debug.dylib"
macos.release.arm64 = "res://bin/libcent_ans.release.dylib"
macos.debug = "res://bin/libcent_ans.debug.dylib"
macos.release = "res://bin/libcent_ans.release.dylib"
windows.debug.x86_64 = "res://bin/cent_ans.debug.dll"
windows.release.x86_64 = "res://bin/cent_ans.release.dll"
