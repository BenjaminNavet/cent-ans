---
source: tests/snapshots.rs
expression: scenarios
---
battle:
  - State(Battle)
  - Wait(600)
  - "Dump(\"[repo]/client/out/smoke/battle.json\")"
  - Exit
campaign:
  - State(Campaign)
  - Wait(300)
  - "Dump(\"[repo]/client/out/smoke/campaign.json\")"
  - "Click(\"hud:open_diplomacy\")"
  - Wait(15)
  - "Click(\"hud:open_tech\")"
  - Wait(15)
  - "Click(\"hud:open_chronicle\")"
  - Wait(15)
  - "Click(\"hud:open_feudal\")"
  - Wait(15)
  - "Click(\"hud:open_council\")"
  - Wait(15)
  - "Click(\"hud:open_faction\")"
  - Wait(15)
  - "Key(\"Escape\")"
  - Wait(15)
  - "Key(\"KeyW\")"
  - Wait(60)
  - "Dump(\"[repo]/client/out/smoke/campaign_panels.json\")"
  - Exit
campaign_battle:
  - State(Campaign)
  - Wait(200)
  - "Click(\"flow:fight\")"
  - Wait(300)
