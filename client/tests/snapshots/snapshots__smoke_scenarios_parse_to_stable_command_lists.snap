  - "Key(\"Enter\")"
  - Wait(200)
  - "Key(\"Enter\")"
  - Wait(200)
  - "Key(\"Enter\")"
  - Wait(200)
  - "Key(\"Enter\")"
  - Wait(200)
  - "Key(\"Enter\")"
  - Wait(200)
  - "Dump(\"[repo]/client/out/smoke/turns_1.json\")"
  - Exit
